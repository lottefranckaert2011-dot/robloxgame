    <Item class="Script" referent="6">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Startpunt van de server: bouwt de hal en de zalen en start alle systemen.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local Config = require(ReplicatedStorage.Shared.Config)
require(ReplicatedStorage.Shared.Remotes) -- maakt de RemoteEvents aan

local LibraryBuilder = require(script.LibraryBuilder)
local LobbyBuilder = require(script.LobbyBuilder)
local KeyService = require(script.KeyService)
local HideService = require(script.HideService)
local DataService = require(script.DataService)
local RoomService = require(script.RoomService)
local ShopService = require(script.ShopService)

-- Warme, lichte bibliotheek zoals in het origineel
Lighting.ClockTime = 14.5
Lighting.Brightness = 2.2
Lighting.Ambient = Color3.fromRGB(150, 124, 118)
Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 160)
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.4
Lighting.GlobalShadows = true
Lighting.ShadowSoftness = 0.4
Lighting.FogEnd = 100000
local colorCorrection = Instance.new("ColorCorrectionEffect")
colorCorrection.Saturation = 0.12
colorCorrection.Contrast = 0.05
colorCorrection.Brightness = 0.02
colorCorrection.TintColor = Color3.fromRGB(255, 244, 236)
colorCorrection.Parent = Lighting
local bloom = Instance.new("BloomEffect")
bloom.Intensity = 0.6
bloom.Size = 30
bloom.Threshold = 1.6
bloom.Parent = Lighting
local atmosphere = Instance.new("Atmosphere")
atmosphere.Density = 0.12
atmosphere.Haze = 0.5
atmosphere.Color = Color3.fromRGB(255, 225, 235)
atmosphere.Decay = Color3.fromRGB(180, 120, 200)
atmosphere.Parent = Lighting

Players.RespawnTime = Config.RespawnTime
StarterPlayer.CharacterWalkSpeed = Config.WalkSpeed
StarterPlayer.CharacterUseJumpPower = false
StarterPlayer.CharacterJumpHeight = Config.BaseJumpHeight
StarterPlayer.EnableMouseLockOption = false -- Shift is voor sprinten

local lobby = LobbyBuilder.Build(Workspace)

local roomsFolder = Instance.new("Folder")
roomsFolder.Name = "Rooms"
roomsFolder.Parent = Workspace
local libraries = {}
local libraryList = {}
for _, room in Config.Rooms do
	local library = LibraryBuilder.Build(room, roomsFolder)
	libraries[room.Id] = library
	table.insert(libraryList, library)
end

KeyService.Init(libraryList)
HideService.Init(libraryList)
DataService.Init()
RoomService.Init(lobby, libraries)
ShopService.Init()

print(Config.GameName .. " is gestart!")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">BookService</string>
          <string name="Source"><![CDATA[-- Boeken in één zaal: verspreiden, oppakken, dragen, laten vallen en in de juiste kast zetten.
-- Elke zaal krijgt zijn eigen BookService (BookService.new).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

export type BookData = {
	Id: number,
	Code: string,
	Title: string,
	Color: Color3,
	Scale: number,
	Font: Enum.Font,
}

local BOOK_COLORS = {
	Color3.fromRGB(196, 52, 48),
	Color3.fromRGB(38, 88, 170),
	Color3.fromRGB(58, 128, 72),
	Color3.fromRGB(226, 170, 60),
	Color3.fromRGB(120, 66, 160),
	Color3.fromRGB(40, 40, 46),
	Color3.fromRGB(232, 120, 160),
	Color3.fromRGB(230, 112, 40),
	Color3.fromRGB(70, 170, 190),
	Color3.fromRGB(150, 90, 50),
	Color3.fromRGB(235, 225, 200),
}

local BOOK_FONTS = {
	Enum.Font.Garamond,
	Enum.Font.Fantasy,
	Enum.Font.Antique,
	Enum.Font.Bodoni,
	Enum.Font.Cartoon,
	Enum.Font.GothamBlack,
	Enum.Font.FredokaOne,
	Enum.Font.Merriweather,
}

local BASE_SIZE = Vector3.new(1.4, 0.35, 1.9)
local PAGES_COLOR = Color3.fromRGB(246, 236, 210)
local nextId = 0

local function playSound(id: string, parent: Instance)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = 0.6
	sound.RollOffMaxDistance = 60
	sound.Parent = parent
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(5, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

local function notify(player: Player, text: string, color: Color3?)
	Remotes.Notify:FireClient(player, text, color)
end

local function getCapacity(player: Player): number
	local capacity = player:GetAttribute("Capacity")
	return if type(capacity) == "number" then capacity else Config.BaseCapacity
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Maakt de onderdelen van een boek: kaft + bladzijden die aan drie kanten uitsteken.
local function buildBookParts(book: BookData, scale: number): BasePart
	local size = BASE_SIZE * scale
	local cover = Instance.new("Part")
	cover.Name = "Book"
	cover.Size = size
	cover.Color = book.Color
	cover.Material = Enum.Material.SmoothPlastic
	cover.TopSurface = Enum.SurfaceType.Smooth
	cover.BottomSurface = Enum.SurfaceType.Smooth
	cover.CanCollide = false
	cover.CanTouch = false

	local pages = Instance.new("Part")
	pages.Name = "Pages"
	pages.Size = Vector3.new(size.X - 0.1 * scale, size.Y * 0.7, size.Z + 0.04)
	pages.Color = PAGES_COLOR
	pages.Material = Enum.Material.SmoothPlastic
	pages.CanCollide = false
	pages.CanTouch = false
	pages.Massless = true
	pages.Anchored = false
	pages:SetAttribute("IsBook", true)
	local weld = Instance.new("Weld")
	weld.Part0 = cover
	weld.Part1 = pages
	weld.C0 = CFrame.new(0.05 * scale + 0.02, 0, 0)
	weld.Parent = pages
	pages.Parent = cover

	-- Voorkant: titel tussen twee gouden banden
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 70
	gui.Parent = cover
	local band = Instance.new("Frame")
	band.Size = UDim2.new(1, 0, 0.08, 0)
	band.Position = UDim2.fromScale(0, 0.12)
	band.BorderSizePixel = 0
	band.BackgroundColor3 = Color3.fromRGB(240, 210, 120)
	band.Parent = gui
	local band2 = band:Clone()
	band2.Position = UDim2.fromScale(0, 0.8)
	band2.Parent = gui
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(0.9, 0.5)
	title.Position = UDim2.fromScale(0.05, 0.25)
	title.TextScaled = true
	title.TextWrapped = true
	title.Font = book.Font
	title.TextColor3 = if book.Color.R + book.Color.G + book.Color.B > 2 then Color3.fromRGB(60, 40, 30) else Color3.fromRGB(250, 238, 205)
	title.Text = book.Title
	title.Parent = gui

	-- Rug: de code, zoals op de echte boeken
	local spine = Instance.new("SurfaceGui")
	spine.Face = Enum.NormalId.Left
	spine.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	spine.PixelsPerStud = 80
	spine.Parent = cover
	local code = Instance.new("TextLabel")
	code.BackgroundTransparency = 1
	code.Size = UDim2.fromScale(1, 1)
	code.TextScaled = true
	code.Font = Enum.Font.GothamBlack
	code.TextColor3 = title.TextColor3
	code.Text = book.Code
	code.Parent = spine

	cover:SetAttribute("IsBook", true)
	return cover
end

-- Zet kaft én bladzijden op hun plek (ook buiten Workspace)
local function moveBook(cover: BasePart, cf: CFrame)
	cover.CFrame = cf
	local pages = cover:FindFirstChild("Pages") :: BasePart?
	local weld = pages and pages:FindFirstChildOfClass("Weld")
	if pages and weld then
		pages.CFrame = cf * weld.C0
	end
end

-- Stapel boeken die je zichtbaar voor je uit draagt
local function updateCarryVisual(player: Player, books: { BookData })
	local character = player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local old = character:FindFirstChild("CarriedBooks")
	if old then
		old:Destroy()
	end
	if not root or #books == 0 then
		return
	end
	local model = Instance.new("Model")
	model.Name = "CarriedBooks"
	local height = -0.5
	for i, book in books do
		local scale = math.min(book.Scale, 1.1)
		local p = buildBookParts(book, scale)
		p.CanQuery = false
		p.Massless = true
		p.Anchored = false
		local pages = p:FindFirstChild("Pages") :: BasePart?
		if pages then
			pages.CanQuery = false
		end
		height += BASE_SIZE.Y * scale / 2
		moveBook(p, root.CFrame * CFrame.new(0, height, -1.4) * CFrame.Angles(0, math.rad((i * 37) % 24 - 12), 0))
		height += BASE_SIZE.Y * scale / 2 + 0.02
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		p.Parent = model
	end
	model.Parent = character
end

local BookService = {}
BookService.__index = BookService

export type BookService = typeof(setmetatable(
	{} :: {
		Room: Config.RoomInfo,
		Library: any,
		State: Instance,
		Folder: Folder,
		Total: number,
		Placed: number,
		Active: boolean,
		Carried: { [Player]: { BookData } },
		PlacedPerSection: { [string]: number },
		BookData: { [BasePart]: BookData },
		OnAllPlaced: (() -> ())?,
		OnMistake: ((player: Player, position: Vector3) -> ())?,
		OnBookPlaced: ((player: Player, count: number) -> ())?,
	},
	BookService
))

function BookService.new(room: Config.RoomInfo, library, state: Instance): BookService
	local self = setmetatable({
		Room = room,
		Library = library,
		State = state,
		Folder = library.Books,
		Total = Config.RoomTotalBooks(room),
		Placed = 0,
		Active = false, -- alleen tijdens een ronde kun je boeken pakken
		Carried = {},
		PlacedPerSection = {},
		BookData = {},
		OnAllPlaced = nil,
		OnMistake = nil,
		OnBookPlaced = nil,
	}, BookService)

	for code, section in library.Sections do
		for _, prompt in section.Prompts do
			prompt.Triggered:Connect(function(player)
				self:Place(player, code)
			end)
		end
	end
	self:Clear()
	return self
end

function BookService.AddPlayer(self: BookService, player: Player)
	self.Carried[player] = self.Carried[player] or {}
	self:Changed(player)
end

function BookService.RemovePlayer(self: BookService, player: Player)
	self:Scatter(player)
	self.Carried[player] = nil
	updateCarryVisual(player, {})
end

function BookService.Changed(self: BookService, player: Player)
	local books = self.Carried[player] or {}
	updateCarryVisual(player, books)
	local list = {}
	for _, book in books do
		table.insert(list, { Code = book.Code, Title = book.Title, Color = book.Color })
	end
	Remotes.Inventory:FireClient(player, list, getCapacity(player))
end

-- `surface` is de plek op de vloer/tafel; het boek gaat erbovenop liggen
function BookService.MakeLooseBook(self: BookService, book: BookData, surface: CFrame)
	local p = buildBookParts(book, book.Scale)
	local cf = surface * CFrame.new(0, p.Size.Y / 2, 0)
	-- Af en toe ligt een boek scheef tegen iets aan
	if math.random() < 0.18 then
		local tilt = math.rad(math.random(8, 22))
		cf = surface * CFrame.new(0, p.Size.Y / 2 + math.sin(tilt) * p.Size.X / 2, 0) * CFrame.Angles(0, 0, tilt)
	end
	moveBook(p, cf)
	p.Anchored = true
	p:SetAttribute("Id", book.Id)
	p:SetAttribute("Code", book.Code)
	p:SetAttribute("Title", book.Title)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Oppakken"
	prompt.ObjectText = string.format("[%s] %s", book.Code, book.Title)
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = p
	prompt.Triggered:Connect(function(player)
		self:PickUp(player, p)
	end)

	self.BookData[p] = book
	p.Destroying:Connect(function()
		self.BookData[p] = nil
	end)
	p.Parent = self.Folder
	return p
end

function BookService.PickUp(self: BookService, player: Player, bookPart: BasePart, silent: boolean?): boolean
	if not self.Active or bookPart.Parent ~= self.Folder or bookPart:GetAttribute("Flying") then
		return false
	end
	if player:GetAttribute("Hidden") then
		return false
	end
	local list = self.Carried[player]
	local book = self.BookData[bookPart]
	if not list or not book then
		return false
	end
	if #list >= getCapacity(player) then
		if not silent then
			notify(player, "Je handen zijn vol! Zet eerst boeken terug.", Color3.fromRGB(255, 120, 80))
		end
		return false
	end
	table.insert(list, book)
	if player.Character and not silent then
		playSound(Config.SoundIds.Pickup, player.Character)
	end
	bookPart:Destroy()
	if not silent then
		self:Changed(player)
	end
	return true
end

function BookService.UpdateSign(self: BookService, section)
	local count = self.PlacedPerSection[section.Code] or 0
	local perSection = self.Room.BooksPerSection
	local done = count >= perSection
	for _, label in section.Counters do
		label.Text = if done then "✔ " .. section.Name else string.format("%s · %d/%d", section.Name, count, perSection)
		label.TextColor3 = if done then Color3.fromRGB(150, 255, 160) else Color3.fromRGB(230, 220, 190)
	end
end

-- Zet één boek op de volgende lege plek in de kast
function BookService.FillSlot(self: BookService, section, book: BookData)
	local count = (self.PlacedPerSection[section.Code] or 0) + 1
	local slot = section.Slots[count]
	if slot then
		slot.Transparency = 0
		slot.Material = Enum.Material.SmoothPlastic
		slot.Color = book.Color
	end
	self.PlacedPerSection[section.Code] = count
	self.Placed += 1
end

-- Na het terugzetten: teller, melding, beloning, en kijken of alles klaar is
function BookService.AfterPlaced(self: BookService, player: Player, section, placedNow: number, quiet: boolean?)
	self.State:SetAttribute("Placed", self.Placed)
	self:UpdateSign(section)
	if self.OnBookPlaced then
		self.OnBookPlaced(player, placedNow)
	end
	if (self.PlacedPerSection[section.Code] or 0) >= self.Room.BooksPerSection then
		for other in self.Carried do
			notify(other, string.format("Sectie %s %s is compleet!", section.Code, section.Name), Color3.fromRGB(150, 255, 160))
		end
	elseif not quiet then
		notify(player, string.format("+%d boek%s in %s", placedNow, if placedNow == 1 then "" else "en", section.Name), Color3.fromRGB(120, 255, 140))
	end
	if self.Placed >= self.Total and self.OnAllPlaced then
		self.OnAllPlaced()
	end
end

-- Zet alle gedragen boeken met deze code in de kast. Geeft het aantal terug.
function BookService.PlaceMatching(self: BookService, player: Player, code: string, quiet: boolean?): number
	local list = self.Carried[player]
	local section = self.Library.Sections[code]
	if not list or not section then
		return 0
	end
	local placedNow = 0
	for i = #list, 1, -1 do
		if list[i].Code == code then
			self:FillSlot(section, list[i])
			table.remove(list, i)
			placedNow += 1
		end
	end
	if placedNow > 0 then
		self:AfterPlaced(player, section, placedNow, quiet)
	end
	return placedNow
end

function BookService.Place(self: BookService, player: Player, code: string)
	if not self.Active then
		return
	end
	local list = self.Carried[player]
	local section = self.Library.Sections[code]
	if not list or not section then
		return
	end
	if #list == 0 then
		notify(player, "Je draagt geen boeken.", Color3.fromRGB(220, 220, 220))
		return
	end

	local character = player.Character
	local placedNow = self:PlaceMatching(player, code)
	if placedNow == 0 then
		notify(player, string.format("Verkeerde kast! Dit is %s %s.", section.Code, section.Name), Color3.fromRGB(255, 90, 90))
		if character then
			playSound(Config.SoundIds.Wrong, character)
			local root = getRoot(player)
			if root and self.OnMistake then
				self.OnMistake(player, root.Position)
			end
		end
		return
	end
	if character then
		playSound(Config.SoundIds.Place, character)
	end
	self:Changed(player)
end

-- Magie "Verzamelen": pak de dichtstbijzijnde boeken op
function BookService.Assemble(self: BookService, player: Player, radius: number): number
	local root = getRoot(player)
	local list = self.Carried[player]
	if not self.Active or not root or not list then
		return 0
	end
	local nearby = {}
	for _, p in self.Folder:GetChildren() do
		if p:IsA("BasePart") and not p:GetAttribute("Flying") then
			local d = (p.Position - root.Position).Magnitude
			if d <= radius then
				table.insert(nearby, { part = p, distance = d })
			end
		end
	end
	table.sort(nearby, function(a, b)
		return a.distance < b.distance
	end)
	local got = 0
	for _, entry in nearby do
		if #list >= getCapacity(player) then
			break
		end
		if self:PickUp(player, entry.part, true) then
			got += 1
		end
	end
	if got > 0 then
		playSound(Config.SoundIds.Pickup, root)
		self:Changed(player)
	end
	return got
end

-- Magie "Auto-plaatsen": alle gedragen boeken naar de goede kast
function BookService.AutoShelf(self: BookService, player: Player): number
	local list = self.Carried[player]
	if not self.Active or not list or #list == 0 then
		return 0
	end
	local codes = {}
	for _, book in list do
		codes[book.Code] = true
	end
	local total = 0
	for code in codes do
		total += self:PlaceMatching(player, code, true)
	end
	if total > 0 then
		local root = getRoot(player)
		if root then
			playSound(Config.SoundIds.Place, root)
		end
		self:Changed(player)
	end
	return total
end

-- De assistent laat een willekeurig boek naar de goede kast vliegen
function BookService.AssistantPlace(self: BookService, player: Player): boolean
	if not self.Active then
		return false
	end
	local candidates = {}
	for _, p in self.Folder:GetChildren() do
		if p:IsA("BasePart") and not p:GetAttribute("Flying") and self.BookData[p] then
			table.insert(candidates, p)
		end
	end
	if #candidates == 0 then
		return false
	end
	local p = candidates[math.random(1, #candidates)] :: BasePart
	local book = self.BookData[p]
	local section = self.Library.Sections[book.Code]
	if not section then
		return false
	end
	p:SetAttribute("Flying", true)
	local prompt = p:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.Enabled = false
	end
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = Color3.fromRGB(255, 230, 140)
	sparkles.Parent = p

	local target = section.Target.Position
	local up = p.CFrame + Vector3.new(0, 6, 0)
	local tween1 = TweenService:Create(p, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = up })
	tween1:Play()
	tween1.Completed:Wait()
	if not p.Parent then
		return false
	end
	local distance = (target - p.Position).Magnitude
	local tween2 = TweenService:Create(
		p,
		TweenInfo.new(math.clamp(distance / 40, 0.8, 3), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ CFrame = CFrame.new(target) * CFrame.Angles(0, math.rad(180), 0) }
	)
	tween2:Play()
	tween2.Completed:Wait()
	if not p.Parent or not self.Active then
		return false
	end
	p:Destroy()
	self:FillSlot(section, book)
	self:AfterPlaced(player, section, 1, true)
	return true
end

function BookService.Drop(self: BookService, player: Player)
	local list = self.Carried[player]
	if not list or #list == 0 then
		return
	end
	local root = getRoot(player)
	for _, book in list do
		local spot = root and self.Library:BookSpotNear(root.Position, 3, self.Folder)
		self:MakeLooseBook(book, spot or self.Library:RandomBookSpot())
	end
	table.clear(list)
	self:Changed(player)
end

-- Als het monster je pakt, vliegen je boeken terug door de hele zaal
function BookService.Scatter(self: BookService, player: Player)
	local list = self.Carried[player]
	if not list or #list == 0 then
		return
	end
	if self.Active then
		for _, book in list do
			self:MakeLooseBook(book, self.Library:RandomBookSpot())
		end
	end
	table.clear(list)
	self:Changed(player)
end

function BookService.Clear(self: BookService)
	self.Active = false
	self.Folder:ClearAllChildren()
	for player, list in self.Carried do
		table.clear(list)
		self:Changed(player)
	end
	table.clear(self.PlacedPerSection)
	self.Placed = 0
	self.State:SetAttribute("Placed", 0)
	self.State:SetAttribute("Total", self.Total)
	for _, section in self.Library.Sections do
		for _, slot in section.Slots do
			slot.Transparency = 0.75
			slot.Material = Enum.Material.Glass
			slot.Color = Color3.fromRGB(255, 245, 225)
		end
		self:UpdateSign(section)
	end
end

function BookService.SpawnAll(self: BookService)
	local library = self.Library
	-- Boeken liggen in rommelige stapels verspreid door de zaal
	local clusters = {}
	local clusterCount = math.max(12, math.floor(self.Total / 5.5))
	for i = 1, clusterCount do
		clusters[i] = library:RandomBookSpot().Position
	end
	for _, entry in Config.RoomSections(self.Room) do
		local section = entry.Section
		for i = 1, self.Room.BooksPerSection do
			nextId += 1
			local title = section.Titles[(i - 1) % #section.Titles + 1]
			if i > #section.Titles then
				title ..= " " .. (math.floor((i - 1) / #section.Titles) + 1)
			end
			local scale = if math.random() < 0.15 then math.random(130, 165) / 100 else math.random(85, 120) / 100
			local book: BookData = {
				Id = nextId,
				Code = section.Code,
				Title = title,
				Color = BOOK_COLORS[math.random(1, #BOOK_COLORS)],
				Scale = scale,
				Font = BOOK_FONTS[math.random(1, #BOOK_FONTS)],
			}
			local center = clusters[math.random(1, #clusters)]
			local spot = library:BookSpotNear(center, 7, self.Folder) or library:RandomBookSpot()
			self:MakeLooseBook(book, spot)
		end
	end
	self.Active = true
end

return BookService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Slaat munten, gevonden sleutels en je snelste tijd op met DataStoreService.
-- In Studio werkt dit alleen als "Enable Studio Access to API Services" aan staat.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local STORE_NAME = "CleanTheLibraryNightmare_v1"

export type Profile = {
	Coins: number,
	Keys: { [string]: boolean },
	BestTime: number?,
	Wins: number,
	Upgrades: { [string]: number }, -- winkel-upgrades en hun niveau
	Magic: { [string]: boolean }, -- gekochte vaardigheden
	Assistant: number, -- niveau van de assistent (0 = geen)
}

local DataService = {}
DataService.OnLoaded = nil :: ((player: Player, profile: Profile) -> ())?

local store: DataStore? = nil
local profiles: { [Player]: Profile } = {}

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore niet beschikbaar, voortgang wordt niet opgeslagen: " .. tostring(result))
	end
end

local function defaultProfile(): Profile
	return { Coins = 0, Keys = {}, BestTime = nil, Wins = 0, Upgrades = {}, Magic = {}, Assistant = 0 }
end

local function load(player: Player): Profile
	local profile = defaultProfile()
	if store then
		local ok, data = pcall(function()
			return store:GetAsync("player_" .. player.UserId)
		end)
		if ok and type(data) == "table" then
			profile.Coins = tonumber(data.Coins) or 0
			profile.Wins = tonumber(data.Wins) or 0
			profile.BestTime = tonumber(data.BestTime)
			profile.Assistant = tonumber(data.Assistant) or 0
			if type(data.Keys) == "table" then
				for id, value in data.Keys do
					profile.Keys[tostring(id)] = value == true
				end
			end
			if type(data.Magic) == "table" then
				for id, value in data.Magic do
					profile.Magic[tostring(id)] = value == true
				end
			end
			if type(data.Upgrades) == "table" then
				for id, value in data.Upgrades do
					profile.Upgrades[tostring(id)] = tonumber(value) or 0
				end
			end
		elseif not ok then
			warn("[Data] Laden mislukt voor " .. player.Name .. ": " .. tostring(data))
		end
	end
	return profile
end

local function save(player: Player)
	local profile = profiles[player]
	if not profile or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("player_" .. player.UserId, profile)
	end)
	if not ok then
		warn("[Data] Opslaan mislukt voor " .. player.Name .. ": " .. tostring(err))
	end
end

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

local function updateStats(player: Player)
	local profile = profiles[player]
	local stats = player:FindFirstChild("leaderstats")
	if not profile or not stats then
		return
	end
	local coins = stats:FindFirstChild("Munten") :: IntValue?
	if coins then
		coins.Value = profile.Coins
	end
	player:SetAttribute("Coins", profile.Coins)
end

function DataService.AddCoins(player: Player, amount: number)
	local profile = profiles[player]
	if profile then
		profile.Coins += amount
		updateStats(player)
	end
end

-- Geeft true terug als de speler genoeg munten had
function DataService.SpendCoins(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or profile.Coins < amount then
		return false
	end
	profile.Coins -= amount
	updateStats(player)
	return true
end

function DataService.SetRoundBooks(player: Player, value: number)
	local stats = player:FindFirstChild("leaderstats")
	local books = stats and stats:FindFirstChild("Boeken") :: IntValue?
	if books then
		books.Value = value
	end
end

function DataService.GetRoundBooks(player: Player): number
	local stats = player:FindFirstChild("leaderstats")
	local books = stats and stats:FindFirstChild("Boeken") :: IntValue?
	return if books then books.Value else 0
end

local function onPlayerAdded(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local books = Instance.new("IntValue")
	books.Name = "Boeken"
	books.Parent = stats
	local coins = Instance.new("IntValue")
	coins.Name = "Munten"
	coins.Parent = stats
	stats.Parent = player

	local profile = load(player)
	if not player.Parent then
		return
	end
	profiles[player] = profile
	updateStats(player)
	if DataService.OnLoaded then
		DataService.OnLoaded(player, profile)
	end
end

function DataService.Init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
	end)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			save(player)
		end
	end)
	-- Af en toe automatisch opslaan
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				save(player)
			end
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">HideService</string>
          <string name="Source"><![CDATA[-- Verstoppen in kluisjes. Het monster ziet je daar niet...
-- tenzij ze je naar binnen zag kruipen!

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local HideService = {}

local occupant: { [any]: Player } = {}
local hidingIn: { [Player]: any } = {}

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function HideService.Exit(player: Player)
	local locker = hidingIn[player]
	if not locker then
		return
	end
	hidingIn[player] = nil
	occupant[locker] = nil
	locker.Prompt.ActionText = "Verstoppen"
	player:SetAttribute("Hidden", nil)
	local character = player.Character
	local root = getRoot(player)
	if character and root then
		character:PivotTo(locker.Outside)
		root.Anchored = false
	end
end

local function enter(player: Player, locker)
	local character = player.Character
	local root = getRoot(player)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if occupant[locker] then
		Remotes.Notify:FireClient(player, "Hier zit al iemand in!", Color3.fromRGB(255, 200, 120))
		return
	end
	hidingIn[player] = locker
	occupant[locker] = player
	locker.Prompt.ActionText = "Eruit"
	player:SetAttribute("Hidden", true)
	character:PivotTo(locker.Inside)
	root.Anchored = true
	Remotes.Notify:FireClient(player, "Je zit verstopt. Houd je adem in...", Color3.fromRGB(180, 180, 255))
end

function HideService.Init(libraries: { any })
	for _, library in libraries do
		for _, locker in library.Lockers do
			locker.Prompt.Triggered:Connect(function(player)
				if hidingIn[player] == locker then
					HideService.Exit(player)
				elseif not hidingIn[player] then
					enter(player, locker)
				end
			end)
		end
	end

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			-- Na respawnen zit je nergens meer in
			local locker = hidingIn[player]
			if locker then
				hidingIn[player] = nil
				occupant[locker] = nil
				locker.Prompt.ActionText = "Verstoppen"
			end
			player:SetAttribute("Hidden", nil)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local locker = hidingIn[player]
		if locker then
			occupant[locker] = nil
			locker.Prompt.ActionText = "Verstoppen"
		end
		hidingIn[player] = nil
	end)
end

return HideService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">KeyService</string>
          <string name="Source"><![CDATA[-- De vier verborgen sleutels. Elke sleutel geeft een permanente upgrade
-- en wordt per speler opgeslagen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local KeyService = {}

-- Berekent alle upgrades (sleutels, winkel, magie, assistent) en zet ze als attributen
local function applyUpgrades(player: Player)
	local profile = DataService.Get(player)
	local keys = if profile then profile.Keys else {}
	local upgrades = if profile then profile.Upgrades else {}
	for _, info in Config.Keys do
		player:SetAttribute("Key_" .. info.Id, keys[info.Id] == true)
	end
	for _, item in Config.Shop do
		player:SetAttribute("Up_" .. item.Id, upgrades[item.Id] or 0)
	end
	for _, info in Config.Magic do
		player:SetAttribute("Magic_" .. info.Id, profile ~= nil and profile.Magic[info.Id] == true)
	end
	player:SetAttribute("Assistant", if profile then profile.Assistant else 0)

	local capacity = Config.BaseCapacity + (upgrades.Capacity or 0)
	if keys.Golden then
		capacity += 3
	end
	if keys.Azure then
		capacity += 3
	end
	local bonusSpeed = (upgrades.Speed or 0) * Config.SpeedPerLevel
	player:SetAttribute("Capacity", capacity)
	player:SetAttribute("WalkSpeed", Config.WalkSpeed + bonusSpeed)
	player:SetAttribute("SprintSpeed", (if keys.Emerald then Config.EmeraldSprintSpeed else Config.SprintSpeed) + bonusSpeed)
	player:SetAttribute("JumpHeight", if keys.Crimson then Config.CrimsonJumpHeight else Config.BaseJumpHeight)

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = player:GetAttribute("JumpHeight")
	end
end

local function buildKey(info: Config.KeyInfo, position: Vector3, parent: Instance)
	local p = Instance.new("Part")
	p.Name = "Key_" .. info.Id
	p.Anchored = true
	p.CanCollide = false
	p.Material = Enum.Material.Neon
	p.Color = info.Color
	p.CFrame = CFrame.new(position)
	if info.Id == "Crimson" then
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.4, 1.6, 1.6)
	elseif info.Id == "Golden" then
		p.Size = Vector3.new(1.1, 1.1, 1.1)
		p.CFrame = CFrame.new(position) * CFrame.Angles(math.rad(45), 0, math.rad(45))
	elseif info.Id == "Azure" then
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(1.4, 1.4, 1.4)
	else
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(1.2, 1.2, 1.2)
	end
	p:SetAttribute("KeyId", info.Id)

	local light = Instance.new("PointLight")
	light.Color = info.Color
	light.Range = 8
	light.Brightness = 1.5
	light.Parent = p

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Oprapen"
	prompt.ObjectText = info.Name
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = p
	prompt.Triggered:Connect(function(player)
		local profile = DataService.Get(player)
		if not profile then
			return
		end
		if profile.Keys[info.Id] then
			Remotes.Notify:FireClient(player, "Deze sleutel heb je al.", Color3.fromRGB(200, 200, 200))
			return
		end
		profile.Keys[info.Id] = true
		applyUpgrades(player)
		Remotes.Notify:FireClient(player, string.format("🔑 %s gevonden! %s", info.Name, info.Description), info.Color)
	end)

	-- Langzaam ronddraaien en zweven
	p.Parent = parent
	local tween = TweenService:Create(
		p,
		TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ CFrame = p.CFrame * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, math.rad(180), 0) }
	)
	tween:Play()
end

function KeyService.Refresh(player: Player)
	applyUpgrades(player)
end

-- Elke zaal heeft zijn eigen vier sleutels; je hoeft ze maar één keer te vinden
function KeyService.Init(libraries: { any })
	for _, library in libraries do
		local folder = Instance.new("Folder")
		folder.Name = "Keys"
		folder.Parent = library.Model
		for _, info in Config.Keys do
			local spot = library.KeySpots[info.Id]
			if spot then
				buildKey(info, spot, folder)
			end
		end
	end

	DataService.OnLoaded = function(player)
		applyUpgrades(player)
	end
	local function onPlayer(player: Player)
		applyUpgrades(player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid")
			applyUpgrades(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return KeyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">LibraryBuilder</string>
          <string name="Source"><![CDATA[-- Bouwt de hele bibliotheek met code, in de stijl van het origineel:
-- roze/crème muren met bogen en houten pilaren, een glazen dakraam,
-- houten kasten met groene naambordjes, wandlampen, planten en tafels.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Map = Config.Map
local F2 = Map.FloorHeight

local LibraryBuilder = {}

-- Instellingen van de zaal die nu gebouwd wordt
local currentFloors = 2
local currentDark = false

local function levels(): { number }
	return if currentFloors >= 2 then { 0, F2 } else { 0 }
end

export type SectionData = {
	Code: string,
	Name: string,
	Index: number,
	Floor: number,
	Color: Color3,
	Model: Model,
	Center: Vector3,
	Target: BasePart, -- onzichtbaar onderdeel voor de kastgids
	Slots: { BasePart },
	Prompts: { ProximityPrompt },
	Counters: { TextLabel },
}

export type LockerData = {
	Model: Model,
	Inside: CFrame,
	Outside: CFrame,
	Prompt: ProximityPrompt,
}

export type Library = {
	Model: Model,
	Books: Folder,
	Offset: Vector3,
	SpawnCFrame: CFrame,
	ExitPrompt: ProximityPrompt,
	Sections: { [string]: SectionData },
	Lockers: { LockerData },
	Waypoints: { Vector3 },
	KeySpots: { [string]: Vector3 },
	MonsterSpawn: Vector3,
	RandomBookSpot: (self: Library) -> CFrame,
	BookSpotNear: (self: Library, center: Vector3, radius: number, extra: Instance?) -> CFrame?,
}

-- Kleuren uit het origineel
local WALL = Color3.fromRGB(242, 222, 210)
local WALL_PANEL = Color3.fromRGB(232, 200, 192)
local PILLAR = Color3.fromRGB(214, 128, 66)
local MOULDING = Color3.fromRGB(170, 64, 42)
local FLOOR = Color3.fromRGB(178, 76, 40)
local CASE_WOOD = Color3.fromRGB(226, 156, 92)
local CASE_BACK = Color3.fromRGB(206, 132, 72)
local DARK_WOOD = Color3.fromRGB(120, 62, 34)
local GOLD = Color3.fromRGB(230, 186, 96)
local PLAQUE = Color3.fromRGB(52, 112, 94)
local LAMP_LIGHT = Color3.fromRGB(255, 214, 160)

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	-- Shape eerst, anders kan Size verkeerd uitvallen
	if props.Shape then
		p.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Parent" and key ~= "Shape" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

-- Decoratie: botst niet en wordt niet geraakt door raycasts
local function deco(props: { [string]: any }): Part
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return part(props)
end

-- Onderdelen waarop boeken mogen verschijnen krijgen dit attribuut
local function bookSurface(p: BasePart)
	p:SetAttribute("BookSurface", true)
end

local function noBooks(p: BasePart)
	p:SetAttribute("NoBooks", true)
end

local function surfaceGui(p: BasePart, face: Enum.NormalId, pixelsPerStud: number?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.LightInfluence = 0.4
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 50
	gui.Parent = p
	return gui
end

-- Groen naambordje zoals in het origineel. Geeft het label voor de teller terug.
local function plaque(p: BasePart, face: Enum.NormalId, code: string, withCounter: boolean): TextLabel?
	local gui = surfaceGui(p, face, 60)
	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.94, 0.88)
	frame.BackgroundColor3 = PLAQUE
	frame.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = GOLD
	stroke.Thickness = 5
	stroke.Parent = frame

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, if withCounter then 0.62 else 0.9)
	label.Position = UDim2.fromScale(0, if withCounter then 0.06 else 0.05)
	label.Font = Enum.Font.Garamond
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(245, 235, 210)
	label.Text = code
	label.Parent = frame

	if not withCounter then
		return nil
	end
	local counter = Instance.new("TextLabel")
	counter.BackgroundTransparency = 1
	counter.Size = UDim2.fromScale(0.8, 0.26)
	counter.Position = UDim2.fromScale(0.1, 0.66)
	counter.Font = Enum.Font.Garamond
	counter.TextScaled = true
	counter.TextColor3 = Color3.fromRGB(230, 220, 190)
	counter.Text = ""
	counter.Parent = frame
	return counter
end

----------------------------------------------------------------------------
-- Gebouw
----------------------------------------------------------------------------

local function buildFloors(folder: Folder)
	local hx, hz = Map.HalfX, Map.HalfZ

	local floor1 = part({
		Name = "Floor1",
		Size = Vector3.new(hx * 2, 2, hz * 2),
		Position = Vector3.new(0, -1, 0),
		Color = FLOOR,
		Material = Enum.Material.WoodPlanks,
		Parent = folder,
	})
	bookSurface(floor1)
	if currentFloors < 2 then
		return
	end

	-- Eerste verdieping met een gat voor de oprit (x 100..112, z 24..72):
	-- bovenkant hout, onderkant gestuukt plafond
	local holeX0, holeX1, holeZ0, holeZ1 = 100, 112, 24, 72
	local pieces = {
		{ x0 = -hx, x1 = holeX0, z0 = -hz, z1 = hz },
		{ x0 = holeX1, x1 = hx, z0 = -hz, z1 = hz },
		{ x0 = holeX0, x1 = holeX1, z0 = -hz, z1 = holeZ0 },
		{ x0 = holeX0, x1 = holeX1, z0 = holeZ1, z1 = hz },
	}
	for i, r in pieces do
		local size = Vector3.new(r.x1 - r.x0, 1, r.z1 - r.z0)
		local center = Vector3.new((r.x0 + r.x1) / 2, 0, (r.z0 + r.z1) / 2)
		local top = part({
			Name = "Floor2_" .. i,
			Size = size,
			Position = center + Vector3.new(0, F2 - 0.5, 0),
			Color = FLOOR,
			Material = Enum.Material.WoodPlanks,
			Parent = folder,
		})
		bookSurface(top)
		part({
			Name = "Ceiling1_" .. i,
			Size = size,
			Position = center + Vector3.new(0, F2 - 1.5, 0),
			Color = WALL,
			Material = Enum.Material.Plaster,
			Parent = folder,
		})
	end

	-- Oprit naar boven: van (106, 0, 72) naar (106, F2, 24)
	local bottom = Vector3.new(106, 0, holeZ1)
	local top = Vector3.new(106, F2, holeZ0)
	local mid = (bottom + top) / 2
	local length = (top - bottom).Magnitude
	local rampCFrame = CFrame.lookAt(mid, top)
	noBooks(part({
		Name = "Ramp",
		Size = Vector3.new(holeX1 - holeX0, 1, length + 1),
		CFrame = rampCFrame * CFrame.new(0, -0.5, 0),
		Color = DARK_WOOD,
		Material = Enum.Material.WoodPlanks,
		Parent = folder,
	}))
	-- Loper op de oprit
	deco({
		Name = "RampRunner",
		Size = Vector3.new(6, 0.1, length),
		CFrame = rampCFrame * CFrame.new(0, 0.03, 0),
		Color = MOULDING,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})

	-- Leuningen rond het gat op de eerste verdieping
	local rails = {
		{ Vector3.new(0.6, 3.5, holeZ1 - holeZ0), Vector3.new(holeX0 - 0.3, F2 + 1.75, (holeZ0 + holeZ1) / 2) },
		{ Vector3.new(0.6, 3.5, holeZ1 - holeZ0), Vector3.new(holeX1 + 0.3, F2 + 1.75, (holeZ0 + holeZ1) / 2) },
		{ Vector3.new(holeX1 - holeX0, 3.5, 0.6), Vector3.new((holeX0 + holeX1) / 2, F2 + 1.75, holeZ1 + 0.3) },
	}
	for i, r in rails do
		noBooks(part({ Name = "Rail" .. i, Size = r[1], Position = r[2], Color = PILLAR, Material = Enum.Material.Wood, Parent = folder }))
	end
	-- Leuningen langs de oprit zelf
	for _, x in { holeX0 + 0.3, holeX1 - 0.3 } do
		noBooks(part({
			Name = "RampRail",
			Size = Vector3.new(0.4, 3, length),
			CFrame = CFrame.lookAt(Vector3.new(x, mid.Y, mid.Z), Vector3.new(x, top.Y, top.Z)) * CFrame.new(0, 1.5, 0),
			Color = PILLAR,
			Material = Enum.Material.Wood,
			Parent = folder,
		}))
	end
end

-- Een muur met pilaren, boogpanelen, lijsten en wandlampen
local function buildWall(folder: Folder, origin: Vector3, along: Vector3, inward: Vector3, length: number, pillarStep: number, skipBay: ((Vector3, number) -> boolean)?)
	local thickness = 2
	local h = Map.WallHeight + 2
	local wallCenter = origin - inward * (thickness / 2) + Vector3.new(0, h / 2 - 2, 0)
	local rot = CFrame.lookAt(Vector3.zero, inward) -- -Z wijst de kamer in
	part({
		Name = "Wall",
		Size = Vector3.new(length + 4, h, thickness),
		CFrame = CFrame.new(wallCenter) * rot,
		Color = WALL,
		Material = Enum.Material.Plaster,
		Parent = folder,
	})

	local function at(t: number, y: number, depth: number): CFrame
		return CFrame.new(origin + along * t + inward * depth + Vector3.new(0, y, 0)) * rot
	end

	-- Lijsten: plint onderaan en een rode lijst onder elk plafond
	for _, y0 in levels() do
		deco({ Name = "Baseboard", Size = Vector3.new(length, 1, 0.4), CFrame = at(0, y0 + 0.5, 0.2), Color = DARK_WOOD, Parent = folder })
		local top = if y0 == 0 and currentFloors >= 2 then F2 - 2 else Map.WallHeight
		deco({ Name = "Moulding", Size = Vector3.new(length, 1.4, 1), CFrame = at(0, top - 0.7, 0.5), Color = MOULDING, Material = Enum.Material.Wood, Parent = folder })
		deco({ Name = "MouldingTrim", Size = Vector3.new(length, 0.3, 1.3), CFrame = at(0, top - 1.55, 0.65), Color = PILLAR, Material = Enum.Material.Wood, Parent = folder })
	end

	local count = math.floor(length / pillarStep)
	local first = -(count - 1) * pillarStep / 2
	for i = 0, count - 1 do
		local t = first + i * pillarStep
		deco({
			Name = "Pillar",
			Size = Vector3.new(2.6, Map.WallHeight, 1.2),
			CFrame = at(t, Map.WallHeight / 2, 0.6),
			Color = PILLAR,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
		-- Wandlamp op de pilaar (beide verdiepingen)
		for _, y0 in levels() do
			deco({ Name = "SconceBase", Size = Vector3.new(0.7, 1.4, 0.5), CFrame = at(t, y0 + 9, 1.45), Color = GOLD, Material = Enum.Material.Metal, Parent = folder })
			local bulb = deco({
				Name = "SconceBulb",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1, 1, 1),
				CFrame = at(t, y0 + 10.1, 1.9),
				Color = Color3.fromRGB(255, 236, 190),
				Material = Enum.Material.Neon,
				Parent = folder,
			})
			-- In een donkere zaal branden er minder lampen en die flikkeren
			if (currentDark and i % 4 == 0) or (not currentDark and i % 2 == 0) then
				local light = Instance.new("PointLight")
				light.Color = LAMP_LIGHT
				light.Range = 18
				light.Brightness = if currentDark then 0.9 else 1.4
				light.Parent = bulb
				if currentDark then
					bulb:SetAttribute("Flicker", true)
				end
			elseif currentDark then
				bulb.Material = Enum.Material.SmoothPlastic
				bulb.Color = Color3.fromRGB(90, 80, 70)
			end
		end
		-- Boogpaneel tussen deze en de volgende pilaar
		if i < count - 1 then
			local bt = t + pillarStep / 2
			for _, y0 in levels() do
				local bayCenter = origin + along * bt + Vector3.new(0, y0, 0)
				if not (skipBay and skipBay(bayCenter, y0)) then
					local width = math.min(12, pillarStep - 6)
					deco({
						Name = "ArchPanel",
						Size = Vector3.new(width, 9, 0.2),
						CFrame = at(bt, y0 + 7.5, 0.1),
						Color = WALL_PANEL,
						Material = Enum.Material.Plaster,
						Parent = folder,
					})
					deco({
						Name = "ArchTop",
						Shape = Enum.PartType.Cylinder,
						Size = Vector3.new(0.1, width, width),
						CFrame = at(bt, y0 + 12, 0.1) * CFrame.Angles(0, math.rad(90), 0),
						Color = WALL_PANEL,
						Material = Enum.Material.Plaster,
						Parent = folder,
					})
					-- Rand rond de boog
					deco({
						Name = "ArchRim",
						Shape = Enum.PartType.Cylinder,
						Size = Vector3.new(0.08, width + 1, width + 1),
						CFrame = at(bt, y0 + 12, 0.04) * CFrame.Angles(0, math.rad(90), 0),
						Color = PILLAR,
						Material = Enum.Material.Wood,
						Parent = folder,
					})
				end
			end
		end
	end
end

local function buildRoof(folder: Folder)
	local hx, hz = Map.HalfX + 2, Map.HalfZ + 2
	local y = Map.WallHeight + 1
	-- Dakraam in het midden: x -70..70, z -30..30
	local sx0, sx1, sz0, sz1 = -70, 70, -30, 30
	local pieces = {
		{ -hx, hx, -hz, sz0 },
		{ -hx, hx, sz1, hz },
		{ -hx, sx0, sz0, sz1 },
		{ sx1, hx, sz0, sz1 },
	}
	for i, r in pieces do
		part({
			Name = "Roof" .. i,
			Size = Vector3.new(r[2] - r[1], 2, r[4] - r[3]),
			Position = Vector3.new((r[1] + r[2]) / 2, y, (r[3] + r[4]) / 2),
			Color = WALL,
			Material = Enum.Material.Plaster,
			Parent = folder,
		})
	end
	part({
		Name = "Skylight",
		Size = Vector3.new(sx1 - sx0, 0.4, sz1 - sz0),
		Position = Vector3.new(0, y - 0.2, 0),
		Color = Color3.fromRGB(200, 225, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.6,
		CastShadow = false,
		Parent = folder,
	})
	-- Houten balken over het dakraam
	for x = sx0, sx1, 20 do
		deco({ Name = "Beam", Size = Vector3.new(1.4, 1.6, sz1 - sz0 + 2), Position = Vector3.new(x, y - 0.6, 0), Color = MOULDING, Material = Enum.Material.Wood, Parent = folder })
	end
	for _, z in { sz0, sz1 } do
		deco({ Name = "Beam", Size = Vector3.new(sx1 - sx0 + 2, 1.6, 1.4), Position = Vector3.new(0, y - 0.6, z), Color = MOULDING, Material = Enum.Material.Wood, Parent = folder })
	end

	-- Paarse boom boven het dakraam (zoals op de screenshot)
	local trunk = Color3.fromRGB(70, 45, 40)
	local function branch(a: Vector3, b: Vector3, thickness: number)
		deco({
			Name = "Branch",
			Size = Vector3.new(thickness, thickness, (b - a).Magnitude),
			CFrame = CFrame.lookAt((a + b) / 2, b),
			Color = trunk,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	branch(Vector3.new(-180, -2, -20), Vector3.new(-112, 64, -10), 6)
	branch(Vector3.new(-112, 64, -10), Vector3.new(-40, 66, -6), 3.5)
	branch(Vector3.new(-112, 64, -10), Vector3.new(-70, 72, 18), 3)
	branch(Vector3.new(-60, 64, -8), Vector3.new(-20, 70, -24), 2)
	local purple = { Color3.fromRGB(150, 92, 205), Color3.fromRGB(122, 74, 182), Color3.fromRGB(176, 116, 222) }
	local blobs = {
		{ Vector3.new(-40, 70, -6), 26 },
		{ Vector3.new(-70, 76, 18), 24 },
		{ Vector3.new(-16, 74, -24), 20 },
		{ Vector3.new(-95, 66, -12), 22 },
		{ Vector3.new(-50, 80, 10), 22 },
		{ Vector3.new(-5, 66, 4), 16 },
	}
	for i, blob in blobs do
		deco({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(blob[2], blob[2], blob[2]),
			Position = blob[1],
			Color = purple[(i - 1) % #purple + 1],
			Material = Enum.Material.LeafyGrass,
			Parent = folder,
		})
	end
end

local function buildStructure(parent: Model)
	local folder = Instance.new("Folder")
	folder.Name = "Structure"
	folder.Parent = parent

	local hx, hz = Map.HalfX, Map.HalfZ
	buildFloors(folder)
	buildRoof(folder)

	-- Bij de voordeur (midden van de voormuur, begane grond) geen boogpaneel
	local function skipDoor(center: Vector3, y0: number): boolean
		return y0 == 0 and math.abs(center.X) < 10 and center.Z > 0
	end
	buildWall(folder, Vector3.new(0, 0, hz), Vector3.new(1, 0, 0), Vector3.new(0, 0, -1), hx * 2, 20, skipDoor)
	buildWall(folder, Vector3.new(0, 0, -hz), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), hx * 2, 20)
	buildWall(folder, Vector3.new(hx, 0, 0), Vector3.new(0, 0, -1), Vector3.new(-1, 0, 0), hz * 2, 20)
	buildWall(folder, Vector3.new(-hx, 0, 0), Vector3.new(0, 0, 1), Vector3.new(1, 0, 0), hz * 2, 20)

	-- Balie bij de ingang met een stapeltje boeken
	noBooks(part({
		Name = "Desk",
		Size = Vector3.new(16, 3.5, 3),
		Position = Vector3.new(0, 1.75, 58),
		Color = PILLAR,
		Material = Enum.Material.Wood,
		Parent = folder,
	}))
	deco({ Name = "DeskTop", Size = Vector3.new(16.6, 0.3, 3.6), Position = Vector3.new(0, 3.6, 58), Color = MOULDING, Material = Enum.Material.Wood, Parent = folder })
	for i, color in { Color3.fromRGB(40, 80, 150), Color3.fromRGB(150, 40, 50), Color3.fromRGB(60, 130, 70) } do
		deco({
			Name = "DeskBook",
			Size = Vector3.new(1.6, 0.4, 2.1),
			CFrame = CFrame.new(-5, 3.95 + (i - 1) * 0.4, 58) * CFrame.Angles(0, math.rad(i * 17), 0),
			Color = color,
			Parent = folder,
		})
	end

	-- Voordeur met het naambord erboven
	deco({
		Name = "FrontDoor",
		Size = Vector3.new(14, 18, 0.5),
		Position = Vector3.new(0, 9, hz - 0.2),
		Color = MOULDING,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	deco({
		Name = "DoorFrame",
		Size = Vector3.new(16, 19, 0.3),
		Position = Vector3.new(0, 9.5, hz - 0.05),
		Color = PILLAR,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	local title = deco({
		Name = "TitleSign",
		Size = Vector3.new(30, 3, 0.3),
		Position = Vector3.new(0, 20.2, hz - 0.3),
		Color = PLAQUE,
		Parent = folder,
	})
	local gui = surfaceGui(title, Enum.NormalId.Front, 30)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Garamond
	label.TextScaled = true
	label.TextColor3 = GOLD
	label.Text = "📖 Clean The Library"
	label.Parent = gui

	-- Kleed bij de ingang
	deco({ Name = "Rug", Size = Vector3.new(26, 0.1, 12), Position = Vector3.new(0, 0.05, 68), Color = MOULDING, Material = Enum.Material.Fabric, Parent = folder })
	deco({ Name = "RugBorder", Size = Vector3.new(28, 0.08, 14), Position = Vector3.new(0, 0.04, 68), Color = GOLD, Material = Enum.Material.Fabric, Parent = folder })
end

----------------------------------------------------------------------------
-- Kasten
----------------------------------------------------------------------------

-- Eén boogkast (10 breed). Voorkant is +Z.
local function buildCabinet(parent: Model, cf: CFrame)
	local H, D = Map.CaseHeight, Map.CaseDepth
	local W = Map.CaseLength / 3
	local function piece(name: string, size: Vector3, offset: Vector3, color: Color3?)
		local p = part({
			Name = name,
			Size = size,
			CFrame = cf * CFrame.new(offset),
			Color = color or CASE_WOOD,
			Material = Enum.Material.Wood,
			Parent = parent,
		})
		noBooks(p)
		return p
	end
	piece("Back", Vector3.new(W - 0.4, H, 0.4), Vector3.new(0, H / 2, -D / 2 + 0.2), CASE_BACK)
	piece("SideL", Vector3.new(0.5, H, D), Vector3.new(-W / 2 + 0.25, H / 2, 0))
	piece("SideR", Vector3.new(0.5, H, D), Vector3.new(W / 2 - 0.25, H / 2, 0))
	for i, y in { 0.15, 2.9, 5.65, 8.4 } do
		piece("Shelf" .. i, Vector3.new(W - 0.6, 0.3, D - 0.2), Vector3.new(0, y, 0))
	end
	piece("Top", Vector3.new(W + 0.2, 0.6, D + 0.3), Vector3.new(0, H + 0.1, 0), PILLAR)
	-- Plint
	piece("Plinth", Vector3.new(W, 0.6, D + 0.2), Vector3.new(0, 0.3, 0.05), PILLAR)
	-- Boog bovenop, met een lichtere rand eromheen
	noBooks(part({
		Name = "Arch",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, W - 0.6, W - 0.6),
		CFrame = cf * CFrame.new(0, H + 0.4, -D / 2 + 0.3) * CFrame.Angles(0, math.rad(90), 0),
		Color = CASE_BACK,
		Material = Enum.Material.Wood,
		Parent = parent,
	}))
	noBooks(part({
		Name = "ArchRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, W + 0.2, W + 0.2),
		CFrame = cf * CFrame.new(0, H + 0.4, -D / 2 + 0.2) * CFrame.Angles(0, math.rad(90), 0),
		Color = PILLAR,
		Material = Enum.Material.Wood,
		Parent = parent,
	}))
end

local function buildSection(parent: Folder, section: Config.Section, index: number, slot: number, booksPerSection: number): SectionData
	local col = (slot - 1) % #Map.GridX + 1
	local row = math.floor((slot - 1) / #Map.GridX) + 1
	local floorY = if section.Floor == 1 then 0 else F2
	local center = CFrame.new(Map.GridX[col], floorY, Map.GridZ[row])
	local color = Config.SectionColor(index)
	local W = Map.CaseLength / 3
	local H, D = Map.CaseHeight, Map.CaseDepth

	local model = Instance.new("Model")
	model.Name = "Section_" .. section.Code
	model:SetAttribute("Code", section.Code)
	model.Parent = parent

	local counters = {}
	for i = -1, 1 do
		local cf = center * CFrame.new(i * W, 0, 0)
		buildCabinet(model, cf)
		-- Naambordjes voor op de boog (voor- en achterkant)
		for _, side in { 1, -1 } do
			local holder = part({
				Name = "Plaque",
				Size = Vector3.new(4.4, 2.2, 0.1),
				CFrame = cf * CFrame.new(0, H + 2.7, -D / 2 + 0.3 + side * 0.32),
				Transparency = 1,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				Parent = model,
			})
			-- Back = +Z (voorkant van de kast), Front = -Z (achterkant)
			local face = if side == 1 then Enum.NormalId.Back else Enum.NormalId.Front
			local counter = plaque(holder, face, section.Code, i == 0)
			if counter then
				table.insert(counters, counter)
			end
		end
	end

	-- Lege plekken die opvullen als je boeken terugzet
	local slots = {}
	local n = booksPerSection
	local levels = { 0.3, 3.05, 5.8 }
	local perLevel = math.ceil(n / #levels)
	local spacing = (Map.CaseLength - 4) / perLevel
	for i = 1, n do
		local level = math.floor((i - 1) / perLevel) + 1
		local pos = (i - 1) % perLevel
		local x = -Map.CaseLength / 2 + 2 + spacing * (pos + 0.5)
		local ghost = part({
			Name = "Slot" .. i,
			Size = Vector3.new(0.6, 2.1, 1.8),
			CFrame = center * CFrame.new(x, levels[level] + 1.1, 0.2),
			Color = Color3.fromRGB(255, 245, 225),
			Material = Enum.Material.Glass,
			Transparency = 0.75,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Parent = model,
		})
		table.insert(slots, ghost)
	end

	-- Onzichtbaar onderdeel voor de "terugzetten"-knoppen
	local front = part({
		Name = "PromptZone",
		Size = Vector3.new(Map.CaseLength, H, 1),
		CFrame = center * CFrame.new(0, H / 2, D / 2 + 0.6),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = model,
	})
	local title = string.format("%s  %s", section.Code, section.Name)
	local prompts = {}
	for _, x in { -10, 0, 10 } do
		local att = Instance.new("Attachment")
		att.Position = Vector3.new(x, -2, 0)
		att.Parent = front
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Boeken terugzetten"
		prompt.ObjectText = title
		prompt.HoldDuration = 0.2
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt.Parent = att
		table.insert(prompts, prompt)
	end

	return {
		Code = section.Code,
		Name = section.Name,
		Index = index,
		Floor = section.Floor,
		Color = color,
		Model = model,
		Center = center.Position,
		Target = front,
		Slots = slots,
		Prompts = prompts,
		Counters = counters,
	}
end

----------------------------------------------------------------------------
-- Meubels
----------------------------------------------------------------------------

local function buildTable(parent: Folder, pos: Vector3)
	local model = Instance.new("Model")
	model.Name = "ReadingTable"
	model.Parent = parent
	local top = part({
		Name = "Top",
		Size = Vector3.new(14, 0.5, 6),
		Position = pos + Vector3.new(0, 3, 0),
		Color = PILLAR,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	bookSurface(top)
	for _, o in { Vector3.new(-6.3, 0, -2.4), Vector3.new(6.3, 0, -2.4), Vector3.new(-6.3, 0, 2.4), Vector3.new(6.3, 0, 2.4) } do
		noBooks(part({
			Name = "Leg",
			Size = Vector3.new(0.6, 2.75, 0.6),
			Position = pos + o + Vector3.new(0, 1.375, 0),
			Color = DARK_WOOD,
			Material = Enum.Material.Wood,
			Parent = model,
		}))
	end
	-- Groene bureaulamp
	deco({ Name = "LampBase", Size = Vector3.new(0.9, 0.2, 0.9), Position = pos + Vector3.new(0, 3.35, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = model })
	deco({ Name = "LampStem", Size = Vector3.new(0.15, 1.2, 0.15), Position = pos + Vector3.new(0, 3.95, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = model })
	local shade = deco({
		Name = "LampShade",
		Size = Vector3.new(1.8, 0.5, 0.8),
		Position = pos + Vector3.new(0, 4.6, 0),
		Color = Color3.fromRGB(40, 120, 80),
		Material = Enum.Material.Glass,
		Parent = model,
	})
	local light = Instance.new("PointLight")
	light.Color = LAMP_LIGHT
	light.Range = 12
	light.Brightness = 1
	light.Parent = shade
	-- Stoelen
	for _, z in { -4.5, 4.5 } do
		for _, x in { -4, 4 } do
			noBooks(part({ Name = "ChairSeat", Size = Vector3.new(2.2, 0.4, 2.2), Position = pos + Vector3.new(x, 1.8, z), Color = MOULDING, Material = Enum.Material.Fabric, Parent = model }))
			deco({ Name = "ChairBack", Size = Vector3.new(2.2, 2.4, 0.3), Position = pos + Vector3.new(x, 3.2, z + math.sign(z) * 1), Color = DARK_WOOD, Material = Enum.Material.Wood, Parent = model })
		end
	end
end

local function buildPlant(parent: Folder, pos: Vector3)
	local model = Instance.new("Model")
	model.Name = "Plant"
	model.Parent = parent
	noBooks(part({
		Name = "Vase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.2, 2, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, 1.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(160, 178, 112),
		Material = Enum.Material.Marble,
		Parent = model,
	}))
	deco({
		Name = "VaseRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2.4, 2.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 3.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(140, 160, 96),
		Material = Enum.Material.Marble,
		Parent = model,
	})
	for i = 1, 9 do
		local yaw = math.rad(i * 40 + math.random(-10, 10))
		local tilt = math.rad(math.random(15, 40))
		local len = math.random(30, 50) / 10
		deco({
			Name = "Leaf",
			Size = Vector3.new(0.7, len, 0.12),
			CFrame = CFrame.new(pos + Vector3.new(0, 3.2, 0))
				* CFrame.Angles(0, yaw, 0)
				* CFrame.Angles(tilt, 0, 0)
				* CFrame.new(0, len / 2, 0),
			Color = if i % 2 == 0 then Color3.fromRGB(70, 150, 70) else Color3.fromRGB(110, 175, 80),
			Material = Enum.Material.SmoothPlastic,
			Parent = model,
		})
	end
end

-- Houten kast om je in te verstoppen
local function buildLocker(parent: Folder, pos: Vector3, facing: Vector3): LockerData
	local model = Instance.new("Model")
	model.Name = "Wardrobe"
	model.Parent = parent
	local base = CFrame.lookAt(pos, pos + facing)
	local function piece(name: string, size: Vector3, offset: Vector3, color: Color3?)
		local p = part({
			Name = name,
			Size = size,
			CFrame = base * CFrame.new(offset),
			Color = color or CASE_WOOD,
			Material = Enum.Material.Wood,
			Parent = model,
		})
		noBooks(p)
		return p
	end
	-- Voorkant = -Z (CFrame.lookAt kijkt langs -Z)
	piece("Back", Vector3.new(4.6, 8.5, 0.4), Vector3.new(0, 4.25, 2))
	piece("Left", Vector3.new(0.4, 8.5, 4.4), Vector3.new(-2.1, 4.25, 0))
	piece("Right", Vector3.new(0.4, 8.5, 4.4), Vector3.new(2.1, 4.25, 0))
	piece("Roof", Vector3.new(5, 0.6, 4.8), Vector3.new(0, 8.6, 0), PILLAR)
	local door = piece("Door", Vector3.new(3.8, 8, 0.3), Vector3.new(0, 4.2, -2), CASE_BACK)
	-- Deurpaneeltjes en knop
	for _, y in { 2.3, 6 } do
		deco({ Name = "DoorPanel", Size = Vector3.new(2.8, 2.8, 0.08), CFrame = base * CFrame.new(0, y, -2.18), Color = CASE_WOOD, Material = Enum.Material.Wood, Parent = model })
	end
	deco({
		Name = "Knob",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.35, 0.35, 0.35),
		CFrame = base * CFrame.new(1.4, 4.2, -2.25),
		Color = GOLD,
		Material = Enum.Material.Metal,
		Parent = model,
	})

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Verstoppen"
	prompt.ObjectText = "Kast"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Parent = door

	return {
		Model = model,
		Inside = base * CFrame.new(0, 3, 0),
		Outside = base * CFrame.new(0, 3, -5),
		Prompt = prompt,
	}
end

local function buildLamps(parent: Folder)
	-- Hangende kroonluchters op de begane grond
	local ceiling = if currentFloors >= 2 then F2 - 2 else Map.WallHeight
	local index = 0
	for x = -100, 100, 50 do
		for z = -60, 60, 40 do
			index += 1
			local y = if currentFloors >= 2 then F2 - 4.5 else 30
			local chain = ceiling - (y + 0.6)
			deco({ Name = "Chain", Size = Vector3.new(0.15, chain, 0.15), Position = Vector3.new(x, y + 0.6 + chain / 2, z), Color = GOLD, Material = Enum.Material.Metal, Parent = parent })
			deco({ Name = "Crown", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 3, 3), CFrame = CFrame.new(x, y + 0.6, z) * CFrame.Angles(0, 0, math.rad(90)), Color = GOLD, Material = Enum.Material.Metal, Parent = parent })
			local lamp = deco({
				Name = "Lamp",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.8, 1.8, 1.8),
				Position = Vector3.new(x, y, z),
				Color = Color3.fromRGB(255, 236, 190),
				Material = Enum.Material.Neon,
				Parent = parent,
			})
			local light = Instance.new("PointLight")
			light.Color = LAMP_LIGHT
			light.Range = 30
			light.Brightness = if currentDark then 0.7 else 1.2
			light.Parent = lamp
			if currentDark and index % 3 == 0 then
				lamp:SetAttribute("Flicker", true)
			end
		end
	end
end

local function isInsideRect(pos: Vector3, x0: number, x1: number, z0: number, z1: number): boolean
	return pos.X >= x0 and pos.X <= x1 and pos.Z >= z0 and pos.Z <= z1
end

function LibraryBuilder.Build(room: Config.RoomInfo, parent: Instance): Library
	currentFloors = room.Floors
	currentDark = room.Dark
	local offset = room.Offset

	local model = Instance.new("Model")
	model.Name = room.Id
	model:SetAttribute("RoomId", room.Id)
	model:SetAttribute("Dark", room.Dark)

	buildStructure(model)

	-- Deur terug naar de hal
	local exitPrompt = Instance.new("ProximityPrompt")
	exitPrompt.ActionText = "Terug naar de hal"
	exitPrompt.ObjectText = "Deur"
	exitPrompt.HoldDuration = 0.5
	exitPrompt.MaxActivationDistance = 12
	exitPrompt.RequiresLineOfSight = false
	exitPrompt.Parent = model:FindFirstChild("FrontDoor", true)

	local sectionsFolder = Instance.new("Folder")
	sectionsFolder.Name = "Sections"
	sectionsFolder.Parent = model

	local sections: { [string]: SectionData } = {}
	local usedSlots = { [1] = 0, [2] = 0 }
	for _, entry in Config.RoomSections(room) do
		local section = entry.Section
		usedSlots[section.Floor] += 1
		sections[section.Code] = buildSection(sectionsFolder, section, entry.Index, usedSlots[section.Floor], room.BooksPerSection)
	end

	-- Leestafels op de overgebleven plekken in het rooster
	local furniture = Instance.new("Folder")
	furniture.Name = "Furniture"
	furniture.Parent = model
	local slotCount = #Map.GridX * #Map.GridZ
	for floor = 1, room.Floors do
		for slot = usedSlots[floor] + 1, slotCount do
			local col = (slot - 1) % #Map.GridX + 1
			local row = math.floor((slot - 1) / #Map.GridX) + 1
			local y = if floor == 1 then 0 else F2
			buildTable(furniture, Vector3.new(Map.GridX[col], y, Map.GridZ[row]))
		end
	end
	-- Extra tafels in de hal bij de ingang
	buildTable(furniture, Vector3.new(-60, 0, 62))
	buildTable(furniture, Vector3.new(60, 0, 62))
	if room.Floors >= 2 then
		buildTable(furniture, Vector3.new(-60, F2, 62))
		buildTable(furniture, Vector3.new(40, F2, 62))
	end

	-- Planten
	local plantSpots = {
		Vector3.new(-115, 0, 75),
		Vector3.new(115, 0, 75),
		Vector3.new(115, 0, -75),
		Vector3.new(-30, 0, 76),
		Vector3.new(30, 0, 76),
		Vector3.new(-11, 0, 58),
		Vector3.new(11, 0, 58),
		Vector3.new(-115, F2, 75),
		Vector3.new(115, F2, 75),
		Vector3.new(115, F2, -75),
		Vector3.new(0, F2, 76),
		Vector3.new(-60, F2, -77),
		Vector3.new(-115, F2, 0),
		Vector3.new(60, 0, -77),
	}
	for _, spot in plantSpots do
		if spot.Y < 1 or room.Floors >= 2 then
			buildPlant(furniture, spot)
		end
	end

	local lamps = Instance.new("Folder")
	lamps.Name = "Lamps"
	lamps.Parent = model
	buildLamps(lamps)

	local lockersFolder = Instance.new("Folder")
	lockersFolder.Name = "Lockers"
	lockersFolder.Parent = model
	local lockers = {}
	local lockerSpots = {
		{ Vector3.new(-117, 0, 60), Vector3.new(1, 0, 0) },
		{ Vector3.new(-117, 0, -40), Vector3.new(1, 0, 0) },
		{ Vector3.new(20, 0, -77), Vector3.new(0, 0, 1) },
		{ Vector3.new(117, 0, -20), Vector3.new(-1, 0, 0) },
		{ Vector3.new(-117, F2, 40), Vector3.new(1, 0, 0) },
		{ Vector3.new(-20, F2, -77), Vector3.new(0, 0, 1) },
		{ Vector3.new(117, F2, -60), Vector3.new(-1, 0, 0) },
		{ Vector3.new(80, F2, 77), Vector3.new(0, 0, -1) },
	}
	for _, spot in lockerSpots do
		if spot[1].Y < 1 or room.Floors >= 2 then
			local locker = buildLocker(lockersFolder, spot[1], spot[2])
			locker.Inside += offset
			locker.Outside += offset
			table.insert(lockers, locker)
		end
	end

	local books = Instance.new("Folder")
	books.Name = "Books"
	books.Parent = model

	-- Patrouillepunten voor het monster (in de gangpaden, beide verdiepingen)
	local waypoints = {}
	for floor = 1, room.Floors do
		local y = (if floor == 1 then 0 else F2) + 3
		for _, x in { -108, -60, -20, 20, 60 } do
			for _, z in { 50, 20, -10, -40, -70 } do
				table.insert(waypoints, Vector3.new(x, y, z))
			end
		end
	end
	table.insert(waypoints, Vector3.new(116, 3, 0))
	if room.Floors >= 2 then
		table.insert(waypoints, Vector3.new(106, 3, 76))
		table.insert(waypoints, Vector3.new(106, F2 + 3, 18))
	end
	for i, point in waypoints do
		waypoints[i] = point + offset
	end

	local keySpots = if room.Floors >= 2
		then {
			Crimson = Vector3.new(106, 1.5, 40), -- onder de oprit
			Golden = Vector3.new(-116, F2 + 1.5, -77), -- achterste hoek boven
			Azure = Vector3.new(-80, 1.5, -77), -- achter de laatste kastenrij beneden
			Emerald = Vector3.new(-40, F2 + 1.5, -58.5), -- achter het Verboden Archief
		}
		else {
			Crimson = Vector3.new(110, 1.5, 40),
			Golden = Vector3.new(-118, 1.5, 20),
			Azure = Vector3.new(-80, 1.5, -77),
			Emerald = Vector3.new(40, 4.8, -55), -- op een leestafel
		}
	for id, spot in keySpots do
		keySpots[id] = spot + offset
	end
	for _, section in sections do
		section.Center += offset
	end

	-- Alles naar de plek van deze zaal schuiven en pas dan in de wereld zetten,
	-- zodat het in één keer bij de spelers aankomt
	model.WorldPivot = CFrame.new()
	model:PivotTo(CFrame.new(offset))
	model.Parent = parent

	local library = {
		Model = model,
		Books = books,
		Offset = offset,
		SpawnCFrame = CFrame.new(Vector3.new(0, 3.5, 66) + offset),
		ExitPrompt = exitPrompt,
		Sections = sections,
		Lockers = lockers,
		Waypoints = waypoints,
		KeySpots = keySpots,
		MonsterSpawn = Vector3.new(0, (if room.Floors >= 2 then F2 else 0) + 6, -70) + offset,
	}

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Include
	rayParams.FilterDescendantsInstances = { model }

	local function blockedSpot(probe: Vector3): boolean
		return isInsideRect(probe, 97, 115, 20, 76) -- oprit
			or isInsideRect(probe, -9, 9, 55, 80) -- balie en spawn
	end

	-- x en z zijn hier coördinaten binnen de zaal (zonder offset)
	local function surfaceAt(x: number, z: number, topY: number, params: RaycastParams): CFrame?
		if blockedSpot(Vector3.new(x, 0, z)) then
			return nil
		end
		local result = Workspace:Raycast(Vector3.new(x, topY, z) + offset, Vector3.new(0, -30, 0), params)
		if not result then
			return nil
		end
		local hit = result.Instance
		if hit:GetAttribute("BookSurface") or hit:GetAttribute("IsBook") then
			local yaw = math.rad(math.random(0, 359))
			return CFrame.new(result.Position) * CFrame.Angles(0, yaw, 0)
		end
		return nil
	end

	-- Zoekt een willekeurige plek op een vloer of tafel voor een boek.
	-- Geeft de CFrame van het oppervlak terug (het boek zet zichzelf erop).
	function library.RandomBookSpot(_self: Library): CFrame
		for _ = 1, 60 do
			local floor = math.random(1, room.Floors)
			local x = math.random(-Map.HalfX + 3, Map.HalfX - 3) + math.random()
			local z = math.random(-Map.HalfZ + 3, Map.HalfZ - 3) + math.random()
			local topY = if floor == 1 then F2 - 3 else Map.WallHeight - 4
			local spot = surfaceAt(x, z, topY, rayParams)
			if spot then
				return spot
			end
		end
		return CFrame.new(Vector3.new(0, 0, 50) + offset)
	end

	-- Plek in de buurt van een punt; met `extra` (bijv. de map met boeken) erbij
	-- kunnen boeken op elkaar komen te liggen, zodat er stapels ontstaan.
	function library.BookSpotNear(_self: Library, center: Vector3, radius: number, extra: Instance?): CFrame?
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = if extra then { model, extra } else { model }
		local localCenter = center - offset
		local floorY = if localCenter.Y >= F2 - 1 then F2 else 0
		local topY = if floorY == 0 then F2 - 3 else Map.WallHeight - 4
		for _ = 1, 12 do
			local angle = math.random() * math.pi * 2
			local r = math.sqrt(math.random()) * radius
			local spot = surfaceAt(localCenter.X + math.cos(angle) * r, localCenter.Z + math.sin(angle) * r, topY, params)
			if spot and spot.Position.Y - offset.Y < floorY + 6 then
				return spot
			end
		end
		return nil
	end

	return library
end

return LibraryBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[-- Bouwt de hal waar je begint: blauwe muren met boogramen, een paars gewelf
-- met houten ribben en een kroonluchter, een reuzenboek als kleed, en
-- achterin een deur met een gloeiende portaalring voor elke zaal.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local LobbyBuilder = {}

export type Door = {
	Room: Config.RoomInfo,
	Prompt: ProximityPrompt,
	Zone: BasePart,
	Info: TextLabel,
}

export type Lobby = {
	Model: Model,
	SpawnCFrame: CFrame,
	Doors: { [string]: Door },
}

local HX, HZ = 70, 50 -- halve breedte en diepte
local WALL_H = 26 -- hoogte van de zijmuren
local RIDGE_H = 44 -- hoogte van de nok

local WALL = Color3.fromRGB(72, 94, 128)
local WAINSCOT = Color3.fromRGB(110, 58, 34)
local TRIM = Color3.fromRGB(214, 128, 66)
local CEILING = Color3.fromRGB(96, 78, 176)
local RIB = Color3.fromRGB(196, 110, 58)
local FLOOR = Color3.fromRGB(182, 92, 44)
local GOLD = Color3.fromRGB(230, 186, 96)
local CREAM = Color3.fromRGB(240, 226, 196)

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	if props.Shape then
		p.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Parent" and key ~= "Shape" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function deco(props: { [string]: any }): Part
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return part(props)
end

-- Grote tekst met een rand, zoals de borden in het origineel
local function signText(p: BasePart, face: Enum.NormalId, text: string, color: Color3, font: Enum.Font?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = font or Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(25, 20, 40)
	stroke.Thickness = 4
	stroke.Parent = label
	return label
end

local function buildShell(folder: Folder)
	part({
		Name = "Floor",
		Size = Vector3.new(HX * 2, 2, HZ * 2),
		Position = Vector3.new(0, -1, 0),
		Color = FLOOR,
		Material = Enum.Material.WoodPlanks,
		Parent = folder,
	})

	-- Zijmuren (met ramen) en voor-/achtermuur tot aan de nok
	for _, side in { -1, 1 } do
		part({
			Name = "SideWall",
			Size = Vector3.new(2, WALL_H + 2, HZ * 2 + 4),
			Position = Vector3.new(side * (HX + 1), WALL_H / 2 - 1, 0),
			Color = WALL,
			Material = Enum.Material.Plaster,
			Parent = folder,
		})
		part({
			Name = "EndWall",
			Size = Vector3.new(HX * 2 + 4, RIDGE_H + 4, 2),
			Position = Vector3.new(0, RIDGE_H / 2, side * (HZ + 1)),
			Color = WALL,
			Material = Enum.Material.Plaster,
			Parent = folder,
		})
	end

	-- Lambrisering en lijsten langs alle muren
	local runs = {
		{ Vector3.new(HX * 2, 0, 0), Vector3.new(0, 0, HZ - 0.3), Vector3.new(1, 0, 0) },
		{ Vector3.new(HX * 2, 0, 0), Vector3.new(0, 0, -HZ + 0.3), Vector3.new(1, 0, 0) },
		{ Vector3.new(0, 0, HZ * 2), Vector3.new(HX - 0.3, 0, 0), Vector3.new(0, 0, 1) },
		{ Vector3.new(0, 0, HZ * 2), Vector3.new(-HX + 0.3, 0, 0), Vector3.new(0, 0, 1) },
	}
	for _, run in runs do
		local length = run[1].Magnitude
		local alongX = run[3].X ~= 0
		local function band(name: string, height: number, y: number, depth: number, color: Color3)
			deco({
				Name = name,
				Size = if alongX then Vector3.new(length, height, depth) else Vector3.new(depth, height, length),
				Position = run[2] + Vector3.new(0, y, 0),
				Color = color,
				Material = Enum.Material.Wood,
				Parent = folder,
			})
		end
		band("Wainscot", 4, 2, 0.6, WAINSCOT)
		band("ChairRail", 0.5, 4.2, 0.9, TRIM)
		band("Crown", 1.4, WALL_H - 0.7, 1.2, TRIM)
	end

	-- Gewelf: twee schuine helften met de nok in het midden (langs Z)
	local rise = RIDGE_H - WALL_H
	local slopeLength = math.sqrt(HX * HX + rise * rise)
	local angle = math.atan2(rise, HX)
	for _, side in { -1, 1 } do
		local center = Vector3.new(side * HX / 2, WALL_H + rise / 2, 0)
		local tilt = CFrame.new(center) * CFrame.Angles(0, 0, side * -angle)
		part({
			Name = "Vault",
			Size = Vector3.new(slopeLength + 2, 1, HZ * 2 + 2),
			CFrame = tilt * CFrame.new(0, 0.5, 0),
			Color = CEILING,
			Material = Enum.Material.Plaster,
			Parent = folder,
		})
		-- Houten ribben over het gewelf
		for z = -HZ + 5, HZ - 5, 12.5 do
			deco({
				Name = "Rib",
				Size = Vector3.new(slopeLength, 1.2, 1.4),
				CFrame = tilt * CFrame.new(0, -0.6, z),
				Color = RIB,
				Material = Enum.Material.Wood,
				Parent = folder,
			})
		end
		-- Schuine kruisribben
		for _, dir in { -1, 1 } do
			local a = Vector3.new(side * HX, WALL_H, dir * HZ)
			local b = Vector3.new(0, RIDGE_H - 0.6, 0)
			local mid = (a + b) / 2
			deco({
				Name = "CrossRib",
				Size = Vector3.new(1, 1, (b - a).Magnitude),
				CFrame = CFrame.lookAt(mid, b) * CFrame.new(0, -1.2, 0),
				Color = RIB,
				Material = Enum.Material.Wood,
				Parent = folder,
			})
		end
	end
	deco({ Name = "Ridge", Size = Vector3.new(2, 1.5, HZ * 2), Position = Vector3.new(0, RIDGE_H - 0.6, 0), Color = RIB, Material = Enum.Material.Wood, Parent = folder })
end

-- Hoog boograam met een raamkruis
local function buildWindow(folder: Folder, x: number, z: number)
	local side = math.sign(x)
	local face = x - side * 0.1
	local function at(y: number, depth: number): CFrame
		return CFrame.new(face - side * depth, y, z) * CFrame.Angles(0, math.rad(90), 0)
	end
	local width, top = 8, 18
	deco({ Name = "WindowFrame", Size = Vector3.new(width + 1.6, top - 5 + 0.8, 0.3), CFrame = at((5 + top) / 2, 0.05), Color = GOLD, Material = Enum.Material.Wood, Parent = folder })
	deco({
		Name = "WindowFrameTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, width + 1.6, width + 1.6),
		CFrame = at(top, 0.05) * CFrame.Angles(0, math.rad(90), 0),
		Color = GOLD,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	deco({
		Name = "Glass",
		Size = Vector3.new(width, top - 5, 0.2),
		CFrame = at((5 + top) / 2, 0.2),
		Color = Color3.fromRGB(170, 215, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.25,
		Parent = folder,
	})
	deco({
		Name = "GlassTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, width, width),
		CFrame = at(top, 0.2) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(170, 215, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.25,
		Parent = folder,
	})
	-- Raamkruis en waaier bovenin
	deco({ Name = "Mullion", Size = Vector3.new(0.4, top - 5 + width / 2, 0.2), CFrame = at((5 + top + width / 2) / 2, 0.35), Color = CREAM, Parent = folder })
	for _, y in { 9, 13.5 } do
		deco({ Name = "Transom", Size = Vector3.new(width, 0.4, 0.2), CFrame = at(y, 0.35), Color = CREAM, Parent = folder })
	end
	for i = -2, 2 do
		deco({
			Name = "Fan",
			Size = Vector3.new(0.3, width / 2, 0.2),
			CFrame = at(top, 0.35) * CFrame.Angles(0, 0, math.rad(i * 30)) * CFrame.new(0, width / 4, 0),
			Color = CREAM,
			Parent = folder,
		})
	end
end

local function buildChandelier(folder: Folder, position: Vector3)
	local chain = RIDGE_H - 1 - (position.Y + 1)
	deco({ Name = "Chain", Size = Vector3.new(0.2, chain, 0.2), Position = position + Vector3.new(0, 1 + chain / 2, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = folder })
	deco({ Name = "Stem", Size = Vector3.new(0.8, 3, 0.8), Position = position, Color = CREAM, Material = Enum.Material.Metal, Parent = folder })
	deco({
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 7, 7),
		CFrame = CFrame.new(position - Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = CREAM,
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	for i = 1, 8 do
		local a = math.rad(i * 45)
		local p = position + Vector3.new(math.cos(a) * 3.4, -0.2, math.sin(a) * 3.4)
		deco({ Name = "Candle", Size = Vector3.new(0.35, 1.2, 0.35), Position = p, Color = Color3.fromRGB(250, 245, 230), Parent = folder })
		deco({
			Name = "Flame",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.4, 0.4, 0.4),
			Position = p + Vector3.new(0, 0.8, 0),
			Color = Color3.fromRGB(255, 210, 120),
			Material = Enum.Material.Neon,
			Parent = folder,
		})
	end
	local glow = deco({ Name = "Glow", Size = Vector3.new(1, 1, 1), Position = position - Vector3.new(0, 1.5, 0), Transparency = 1, Parent = folder })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 170)
	light.Range = 50
	light.Brightness = 1.8
	light.Shadows = true
	light.Parent = glow
end

-- Schilderij boven de deuren
local function buildPainting(folder: Folder)
	local frame = deco({
		Name = "PaintingFrame",
		Size = Vector3.new(46, 11, 0.4),
		Position = Vector3.new(0, 35, -HZ + 0.3),
		Color = GOLD,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	local canvas = deco({
		Name = "Painting",
		Size = Vector3.new(44, 9, 0.2),
		Position = Vector3.new(0, 35, -HZ + 0.55),
		Color = Color3.new(1, 1, 1),
		Parent = folder,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.LightInfluence = 0.3
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.Parent = canvas
	local sky = Instance.new("Frame")
	sky.Size = UDim2.fromScale(1, 1)
	sky.BorderSizePixel = 0
	sky.BackgroundColor3 = Color3.new(1, 1, 1)
	sky.Parent = gui
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(Color3.fromRGB(120, 150, 210), Color3.fromRGB(240, 196, 200))
	gradient.Parent = sky
	-- Heuvels en een kasteel als silhouet
	local function shape(x: number, y: number, w: number, h: number, color: Color3, rotation: number?)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, h)
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		f.Rotation = rotation or 0
		f.Parent = sky
		return f
	end
	local hill = Color3.fromRGB(80, 90, 110)
	shape(0.2, 0.95, 0.6, 0.5, hill, 8)
	shape(0.75, 0.98, 0.7, 0.5, Color3.fromRGB(70, 80, 100), -6)
	shape(0.62, 0.62, 0.05, 0.3, Color3.fromRGB(60, 62, 80))
	shape(0.7, 0.58, 0.06, 0.38, Color3.fromRGB(60, 62, 80))
	shape(0.78, 0.64, 0.05, 0.26, Color3.fromRGB(60, 62, 80))
	shape(0.7, 0.72, 0.2, 0.2, Color3.fromRGB(60, 62, 80))
	local sun = shape(0.22, 0.3, 0.07, 0.3, Color3.fromRGB(255, 236, 190))
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = sun
	return frame
end

-- Reuzenboek als kleed in het midden
local function buildBigBook(folder: Folder)
	local center = Vector3.new(0, 0, 8)
	-- Laag gehouden zodat je er gewoon overheen loopt
	deco({ Name = "BigBookPages", Size = Vector3.new(33, 0.3, 23.4), Position = center + Vector3.new(0.6, 0.15, 0), Color = CREAM, Parent = folder })
	local cover = part({
		Name = "BigBookCover",
		Size = Vector3.new(34, 0.15, 24),
		Position = center + Vector3.new(0, 0.37, 0),
		Color = Color3.fromRGB(40, 104, 80),
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	deco({ Name = "BigBookSpine", Size = Vector3.new(2, 0.2, 24), Position = center + Vector3.new(-16.5, 0.4, 0), Color = Color3.fromRGB(28, 80, 60), Material = Enum.Material.Fabric, Parent = folder })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.Parent = cover
	for _, y in { 0.1, 0.86 } do
		local band = Instance.new("Frame")
		band.Position = UDim2.fromScale(0.08, y)
		band.Size = UDim2.fromScale(0.84, 0.03)
		band.BorderSizePixel = 0
		band.BackgroundColor3 = GOLD
		band.Parent = gui
	end
	local title = Instance.new("TextLabel")
	title.Position = UDim2.fromScale(0.1, 0.2)
	title.Size = UDim2.fromScale(0.8, 0.6)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.Garamond
	title.TextScaled = true
	title.TextColor3 = GOLD
	title.Text = "Clean The\nLibrary"
	title.Parent = gui
end

local function buildPlant(folder: Folder, position: Vector3)
	part({
		Name = "Vase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.2, 2.2, 2.2),
		CFrame = CFrame.new(position + Vector3.new(0, 1.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(160, 178, 112),
		Material = Enum.Material.Marble,
		Parent = folder,
	})
	for i = 1, 9 do
		local len = math.random(35, 55) / 10
		deco({
			Name = "Leaf",
			Size = Vector3.new(0.8, len, 0.12),
			CFrame = CFrame.new(position + Vector3.new(0, 3.2, 0))
				* CFrame.Angles(0, math.rad(i * 40), 0)
				* CFrame.Angles(math.rad(math.random(15, 40)), 0, 0)
				* CFrame.new(0, len / 2, 0),
			Color = if i % 2 == 0 then Color3.fromRGB(70, 150, 70) else Color3.fromRGB(110, 175, 80),
			Parent = folder,
		})
	end
end

-- Kraam met een zwevend bord (Winkel / Magie). De prompt opent het venster op de client.
local function buildStand(folder: Folder, position: Vector3, facing: Vector3, title: string, color: Color3, panel: string)
	local base = CFrame.lookAt(position, position + facing)
	local counter = part({
		Name = "Stand",
		Size = Vector3.new(12, 3.5, 4),
		CFrame = base * CFrame.new(0, 1.75, 0),
		Color = TRIM,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	deco({ Name = "StandTop", Size = Vector3.new(12.6, 0.4, 4.6), CFrame = base * CFrame.new(0, 3.7, 0), Color = color, Parent = folder })
	local sign = deco({ Name = "StandSign", Size = Vector3.new(14, 4, 0.2), CFrame = base * CFrame.new(0, 10, 0), Transparency = 1, Parent = folder })
	signText(sign, Enum.NormalId.Front, title, color)
	signText(sign, Enum.NormalId.Back, title, color)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Openen"
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OpenPanel", panel)
	prompt.Parent = counter
end

local function buildDoor(folder: Folder, room: Config.RoomInfo, x: number): Door
	local z = -HZ
	local base = CFrame.new(x, 0, z + 0.4) -- voorkant (naar de hal) is +Z
	local doorW, doorH = 11, 15
	-- Gloeiende rand in de kleur van de zaal
	deco({
		Name = "DoorGlow",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, doorW + 3, doorW + 3),
		CFrame = base * CFrame.new(0, doorH, 0.05) * CFrame.Angles(0, math.rad(90), 0),
		Color = room.Color,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	deco({ Name = "DoorGlowRect", Size = Vector3.new(doorW + 3, doorH, 0.2), CFrame = base * CFrame.new(0, doorH / 2, 0.05), Color = room.Color, Material = Enum.Material.Neon, Parent = folder })
	-- Houten kozijn
	deco({
		Name = "DoorFrameTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, doorW + 1.6, doorW + 1.6),
		CFrame = base * CFrame.new(0, doorH, 0.2) * CFrame.Angles(0, math.rad(90), 0),
		Color = TRIM,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	deco({ Name = "DoorFrame", Size = Vector3.new(doorW + 1.6, doorH, 0.3), CFrame = base * CFrame.new(0, doorH / 2, 0.2), Color = TRIM, Material = Enum.Material.Wood, Parent = folder })
	-- De deur zelf (twee deurvleugels)
	local door = part({
		Name = "Door",
		Size = Vector3.new(doorW, doorH, 0.4),
		CFrame = base * CFrame.new(0, doorH / 2, 0.45),
		Color = Color3.fromRGB(90, 46, 26),
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	deco({
		Name = "DoorTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, doorW, doorW),
		CFrame = base * CFrame.new(0, doorH, 0.45) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(90, 46, 26),
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	deco({ Name = "DoorSplit", Size = Vector3.new(0.2, doorH + doorW / 2, 0.1), CFrame = base * CFrame.new(0, (doorH + doorW / 2) / 2, 0.7), Color = Color3.fromRGB(50, 24, 14), Parent = folder })
	for _, side in { -1, 1 } do
		deco({
			Name = "Knob",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.6, 0.6, 0.6),
			CFrame = base * CFrame.new(side * 1, 7, 0.8),
			Color = GOLD,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end

	-- Bord met de naam en een regel met live informatie
	local sign = deco({ Name = "DoorSign", Size = Vector3.new(30, 5, 0.2), CFrame = base * CFrame.new(0, 26, 0.3), Transparency = 1, Parent = folder })
	signText(sign, Enum.NormalId.Back, room.Name, room.Color)
	local infoPart = deco({ Name = "DoorInfo", Size = Vector3.new(30, 4.2, 0.2), CFrame = base * CFrame.new(0, 22, 0.3), Transparency = 1, Parent = folder })
	local description = signText(infoPart, Enum.NormalId.Back, room.Description, Color3.new(1, 1, 1), Enum.Font.GothamBlack)
	description.Size = UDim2.fromScale(1, 0.45)
	local info = signText(infoPart, Enum.NormalId.Back, "", Color3.fromRGB(255, 240, 160), Enum.Font.GothamBlack)
	info.Size = UDim2.fromScale(1, 0.45)
	info.Position = UDim2.fromScale(0, 0.52)

	-- Portaalring op de vloer: erin stappen = naar binnen
	local ringCenter = Vector3.new(x, 0, z + 10)
	deco({
		Name = "PortalRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, 11, 11),
		CFrame = CFrame.new(ringCenter + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = room.Color,
		Material = Enum.Material.Neon,
		Transparency = 0.15,
		Parent = folder,
	})
	deco({
		Name = "PortalInner",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.14, 9, 9),
		CFrame = CFrame.new(ringCenter + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = room.Color,
		Material = Enum.Material.Glass,
		Transparency = 0.55,
		Parent = folder,
	})
	local zone = part({
		Name = "PortalZone",
		Size = Vector3.new(9, 6, 9),
		Position = ringCenter + Vector3.new(0, 3, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = folder,
	})
	zone:SetAttribute("RoomId", room.Id)
	local particles = Instance.new("ParticleEmitter")
	particles.Color = ColorSequence.new(room.Color)
	particles.LightEmission = 1
	particles.Size = NumberSequence.new(0.5, 0)
	particles.Lifetime = NumberRange.new(1, 2)
	particles.Rate = 25
	particles.Speed = NumberRange.new(3, 6)
	particles.SpreadAngle = Vector2.new(15, 15)
	particles.EmissionDirection = Enum.NormalId.Top
	particles.Parent = zone
	local light = Instance.new("PointLight")
	light.Color = room.Color
	light.Range = 14
	light.Brightness = 1.5
	light.Parent = zone

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Naar binnen"
	prompt.ObjectText = room.Name
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = door

	return { Room = room, Prompt = prompt, Zone = zone, Info = info }
end

function LobbyBuilder.Build(parent: Instance): Lobby
	local model = Instance.new("Model")
	model.Name = "Lobby"
	local folder = Instance.new("Folder")
	folder.Name = "Structure"
	folder.Parent = model

	buildShell(folder)
	for _, side in { -1, 1 } do
		for _, z in { -30, -10, 10, 30 } do
			buildWindow(folder, side * HX, z)
		end
	end
	buildChandelier(folder, Vector3.new(0, 30, 8))
	buildPainting(folder)
	buildBigBook(folder)
	for _, spot in { Vector3.new(-64, 0, 44), Vector3.new(64, 0, 44), Vector3.new(-64, 0, -44), Vector3.new(64, 0, -44), Vector3.new(-20, 0, -46), Vector3.new(20, 0, -46) } do
		buildPlant(folder, spot)
	end

	buildStand(folder, Vector3.new(-58, 0, 12), Vector3.new(1, 0, 0), "WINKEL", Color3.fromRGB(255, 110, 200), "Shop")
	buildStand(folder, Vector3.new(58, 0, 12), Vector3.new(-1, 0, 0), "MAGIE", Color3.fromRGB(110, 190, 255), "Magic")

	-- Welkomstbord boven de ingang
	local welcome = deco({ Name = "Welcome", Size = Vector3.new(40, 6, 0.2), Position = Vector3.new(0, 20, HZ - 0.3), Transparency = 1, Parent = folder })
	signText(welcome, Enum.NormalId.Front, "Kies een zaal!", Color3.fromRGB(255, 220, 120))

	local doors = {}
	local count = #Config.Rooms
	for i, room in Config.Rooms do
		local x = (i - (count + 1) / 2) * 40
		doors[room.Id] = buildDoor(folder, room, x)
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(12, 1, 8)
	spawn.Position = Vector3.new(0, -0.45, 36)
	spawn.Transparency = 1
	spawn.CanQuery = false
	spawn.Parent = model

	model.Parent = parent
	return {
		Model = model,
		SpawnCFrame = CFrame.new(0, 3.5, 36),
		Doors = doors,
	}
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">MonsterService</string>
          <string name="Source"><![CDATA[-- "De Bibliothecaresse": het monster dat door de donkere bibliotheek sluipt.
-- Ze patrouilleert, hoort sprintende spelers en fouten, en jaagt op wie ze ziet.

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local M = Config.Monster

export type Monster = {
	OnCatch: ((player: Player) -> ())?,
	OnHiddenCatch: ((player: Player) -> ())?,
	Progress: number, -- 0..1, hoe ver de spelers zijn
	Spawn: () -> (),
	Despawn: () -> (),
	Noise: (position: Vector3, range: number) -> (),
}

local MonsterService = {}

-- Maakt het monster voor één zaal. `getPlayers` geeft de spelers in die zaal.
function MonsterService.new(room: Config.RoomInfo, library, getPlayers: () -> { Player }): Monster
	local self = {
		OnCatch = nil,
		OnHiddenCatch = nil,
		Progress = 0,
	} :: any

	local model: Model? = nil
	local humanoid: Humanoid? = nil
	local root: BasePart? = nil
	local head: BasePart? = nil
	local shushLabel: TextLabel? = nil
	local running = false
	local loopId = 0

	-- Toestand van de AI
	local state = "Wander" -- Wander | Investigate | Chase | Pause
	local target: Player? = nil
	local lastSeen = 0
	local lastKnown: Vector3? = nil
	local goal: Vector3? = nil
	local waypoints: { PathWaypoint } = {}
	local wpIndex = 1
	local lastPathTime = 0
	local idleUntil = 0
	local stuckCheckPos = Vector3.zero
	local stuckCheckTime = 0
	local sawHide = false
	local hideChaseStart = 0
	local pendingNoise: Vector3? = nil

	local path = PathfindingService:CreatePath({
		AgentRadius = 2.5,
		AgentHeight = 10,
		AgentCanJump = false,
		WaypointSpacing = 6,
	})

	local function weldPart(parent: Model, rootPart: BasePart, props: { [string]: any }): Part
		local p = Instance.new("Part")
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Material = Enum.Material.SmoothPlastic
		local offset: CFrame = props.Offset
		for key, value in props do
			if key ~= "Offset" then
				(p :: any)[key] = value
			end
		end
		p.CFrame = rootPart.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = rootPart
		weld.Part1 = p
		weld.Parent = p
		p.Parent = parent
		return p
	end

	local function buildModel(position: Vector3): Model
		local m = Instance.new("Model")
		m.Name = M.Name

		local hrp = Instance.new("Part")
		hrp.Name = "HumanoidRootPart"
		hrp.Size = Vector3.new(2, 2, 1)
		hrp.Transparency = 1
		hrp.CanCollide = false
		hrp.CFrame = CFrame.new(position)
		hrp.Parent = m
		m.PrimaryPart = hrp

		local black = Color3.fromRGB(15, 12, 18)
		local skin = Color3.fromRGB(205, 200, 190)

		-- Lang zwart gewaad
		weldPart(m, hrp, {
			Name = "Torso",
			Size = Vector3.new(3, 3.5, 1.4),
			Color = black,
			Material = Enum.Material.Fabric,
			CanCollide = true,
			Massless = false,
			Offset = CFrame.new(0, 1.25, 0),
		})
		weldPart(m, hrp, {
			Name = "Robe",
			Size = Vector3.new(3.4, 4.6, 1.8),
			Color = black,
			Material = Enum.Material.Fabric,
			Offset = CFrame.new(0, -2.6, 0),
		})
		-- Veel te lange armen
		for _, side in { -1, 1 } do
			weldPart(m, hrp, {
				Name = "Arm",
				Size = Vector3.new(0.6, 6.5, 0.6),
				Color = black,
				Material = Enum.Material.Fabric,
				Offset = CFrame.new(side * 1.85, 0, -0.2) * CFrame.Angles(math.rad(-12), 0, math.rad(side * 6)),
			})
			weldPart(m, hrp, {
				Name = "Hand",
				Size = Vector3.new(0.7, 1.2, 0.3),
				Color = skin,
				Offset = CFrame.new(side * 2.1, -3.4, -0.9),
			})
		end
		local headPart = weldPart(m, hrp, {
			Name = "Head",
			Size = Vector3.new(1.8, 2.1, 1.8),
			Color = skin,
			CanCollide = true,
			Massless = false,
			Offset = CFrame.new(0, 4.05, 0),
		})
		-- Haarknot
		weldPart(m, hrp, {
			Name = "Bun",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.4, 1.4, 1.4),
			Color = Color3.fromRGB(60, 60, 64),
			Offset = CFrame.new(0, 5.3, 0.5),
		})
		-- Gloeiende ogen en een bril
		for _, side in { -1, 1 } do
			weldPart(m, hrp, {
				Name = "Eye",
				Size = Vector3.new(0.4, 0.28, 0.1),
				Color = Color3.fromRGB(255, 20, 20),
				Material = Enum.Material.Neon,
				Offset = CFrame.new(side * 0.42, 4.25, -0.92),
			})
			weldPart(m, hrp, {
				Name = "Glasses",
				Size = Vector3.new(0.65, 0.5, 0.05),
				Color = Color3.fromRGB(20, 20, 20),
				Transparency = 0.3,
				Offset = CFrame.new(side * 0.42, 4.25, -0.97),
			})
		end
		weldPart(m, hrp, {
			Name = "Mouth",
			Size = Vector3.new(0.9, 0.12, 0.05),
			Color = Color3.new(0, 0, 0),
			Offset = CFrame.new(0, 3.55, -0.92),
		})

		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 40, 40)
		glow.Range = 14
		glow.Brightness = 2
		glow.Parent = headPart

		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromOffset(220, 60)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = false
		billboard.MaxDistance = 80
		billboard.Parent = headPart
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = ""
		label.TextScaled = true
		label.Font = Enum.Font.Creepster
		label.TextColor3 = Color3.fromRGB(255, 50, 50)
		label.TextStrokeTransparency = 0.3
		label.Parent = billboard

		local hum = Instance.new("Humanoid")
		hum.RigType = Enum.HumanoidRigType.R15
		hum.HipHeight = 4
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.MaxHealth = math.huge
		hum.Health = math.huge
		hum.BreakJointsOnDeath = false
		hum.WalkSpeed = M.WanderSpeed * room.MonsterSpeed
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
		hum.Parent = m

		m:SetAttribute("IsMonster", true)
		m.Parent = library.Model
		hrp:SetNetworkOwner(nil)

		model, humanoid, root, head, shushLabel = m, hum, hrp, headPart, label
		return m
	end

	local function flat(v: Vector3): Vector3
		return Vector3.new(v.X, 0, v.Z)
	end

	local function chaseSpeed(): number
		return (M.ChaseSpeedStart + (M.ChaseSpeedEnd - M.ChaseSpeedStart) * math.clamp(self.Progress, 0, 1)) * room.MonsterSpeed
	end

	local function setGoal(position: Vector3)
		if not root then
			return
		end
		goal = position
		waypoints = {}
		wpIndex = 1
		lastPathTime = os.clock()
		local ok = pcall(function()
			path:ComputeAsync(root.Position, position)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			waypoints = path:GetWaypoints()
			wpIndex = math.min(2, #waypoints)
		end
	end

	-- Loopt de berekende route af. Geeft true terug als het doel bereikt is.
	local function followPath(): boolean
		if not root or not humanoid or not goal then
			return true
		end
		if #waypoints == 0 then
			humanoid:MoveTo(goal)
			return flat(root.Position - goal).Magnitude < 3
		end
		local wp = waypoints[wpIndex]
		if not wp then
			return true
		end
		local delta = wp.Position - root.Position
		if flat(delta).Magnitude < 3 and math.abs(delta.Y) < 7 then
			wpIndex += 1
			wp = waypoints[wpIndex]
			if not wp then
				return true
			end
		end
		humanoid:MoveTo(wp.Position)
		return false
	end

	local function visionParams(): RaycastParams
		local exclude: { Instance } = {}
		if model then
			table.insert(exclude, model)
		end
		local books = library.Books
		if books then
			table.insert(exclude, books)
		end
		for _, player in getPlayers() do
			if player.Character then
				table.insert(exclude, player.Character)
			end
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = exclude
		return params
	end

	local function characterRoot(player: Player): (BasePart?, Humanoid?)
		local character = player.Character
		if not character then
			return nil, nil
		end
		local hum = character:FindFirstChildOfClass("Humanoid")
		local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not hum or not hrp or hum.Health <= 0 then
			return nil, nil
		end
		return hrp, hum
	end

	local function canSee(player: Player, params: RaycastParams): boolean
		if not root or not head then
			return false
		end
		local hrp = characterRoot(player)
		if not hrp or player:GetAttribute("Hidden") then
			return false
		end
		local eye = head.Position
		local offset = hrp.Position - eye
		local dist = offset.Magnitude
		if dist > M.SightRange then
			return false
		end
		if dist > M.CloseDetectRange then
			local look = flat(root.CFrame.LookVector).Unit
			local dir = flat(offset)
			if dir.Magnitude > 0.1 then
				local angle = math.deg(math.acos(math.clamp(look:Dot(dir.Unit), -1, 1)))
				if angle > M.FieldOfView / 2 then
					return false
				end
			end
		end
		local result = Workspace:Raycast(eye, offset, params)
		return result == nil
	end

	local function startChase(player: Player)
		if state ~= "Chase" or target ~= player then
			state = "Chase"
			target = player
			sawHide = false
			Remotes.Notify:FireClient(player, "Ze heeft je gezien! RENNEN!", Color3.fromRGB(255, 40, 40))
		end
		lastSeen = os.clock()
	end

	local function investigate(position: Vector3)
		if state == "Chase" then
			return
		end
		state = "Investigate"
		setGoal(position)
	end

	function self.Noise(position: Vector3, range: number)
		if not root or not running then
			return
		end
		-- Wordt in de volgende tick verwerkt (zo rekent er maar één thread routes uit)
		if (root.Position - position).Magnitude <= range then
			pendingNoise = position
		end
	end

	local function catch(player: Player)
		local hrp, hum = characterRoot(player)
		if not hrp or not hum then
			return
		end
		Remotes.Caught:FireClient(player)
		if self.OnCatch then
			self.OnCatch(player)
		end
		local sound = Instance.new("Sound")
		sound.SoundId = Config.SoundIds.Caught
		sound.Volume = 1
		sound.Parent = hrp
		sound:Play()
		task.delay(0.6, function()
			if hum.Parent then
				hum.Health = 0
			end
		end)
		state = "Pause"
		target = nil
		idleUntil = os.clock() + 3
		if humanoid and root then
			humanoid:MoveTo(root.Position)
		end
	end

	local function pickWander()
		local points = library.Waypoints
		setGoal(points[math.random(1, #points)])
	end

	local function step()
		if not root or not humanoid or not shushLabel then
			return
		end
		local now = os.clock()
		local params = visionParams()

		if pendingNoise then
			local position = pendingNoise
			pendingNoise = nil
			if state == "Wander" or state == "Investigate" then
				investigate(position)
			end
		end

		-- Zien
		local best: Player? = nil
		local bestDist = math.huge
		for _, player in getPlayers() do
			if canSee(player, params) then
				local hrp = characterRoot(player)
				if hrp then
					local d = (hrp.Position - root.Position).Magnitude
					if d < bestDist then
						best, bestDist = player, d
					end
				end
			end
		end
		if best and state ~= "Pause" then
			startChase(best)
		end

		-- Horen: sprintende spelers in de buurt
		if state == "Wander" or state == "Investigate" then
			for _, player in getPlayers() do
				local hrp = characterRoot(player)
				if hrp and not player:GetAttribute("Hidden") then
					local speed = flat(hrp.AssemblyLinearVelocity).Magnitude
					local d = (hrp.Position - root.Position).Magnitude
					if speed > Config.WalkSpeed + 2 and d < M.HearSprintRange and math.abs(hrp.Position.Y - root.Position.Y) < 14 then
						if not goal or (goal - hrp.Position).Magnitude > 10 or state == "Wander" then
							investigate(hrp.Position)
						end
						break
					end
				end
			end
		end

		if state == "Pause" then
			humanoid.WalkSpeed = 0
			shushLabel.Text = ""
			if now >= idleUntil then
				state = "Wander"
				pickWander()
			end
			return
		end

		if state == "Chase" then
			humanoid.WalkSpeed = chaseSpeed()
			shushLabel.Text = "SSSSHHHH!"
			local player = target
			local hrp = player and characterRoot(player)
			if not player or not hrp then
				state = "Wander"
				target = nil
				pickWander()
				return
			end

			if player:GetAttribute("Hidden") then
				-- Zag ze je wegkruipen? Dan trekt ze je uit het kluisje!
				if not sawHide then
					sawHide = true
					hideChaseStart = now
					local closeEnough = (hrp.Position - root.Position).Magnitude < 16
					player:SetAttribute("SeenHiding", closeEnough)
					-- Loop naar de plek vlak voor de deur van het kluisje
					setGoal((hrp.CFrame * CFrame.new(0, 0, -4.5)).Position)
				end
				local arrived = followPath() or (hrp.Position - root.Position).Magnitude < 6
				if not arrived and now - hideChaseStart > 10 then
					-- Kwam er niet bij: opgeven
					player:SetAttribute("SeenHiding", nil)
					state = "Investigate"
					target = nil
					goal = nil
					idleUntil = now + 2
					return
				end
				if arrived then
					if player:GetAttribute("SeenHiding") and self.OnHiddenCatch then
						self.OnHiddenCatch(player)
						catch(player)
					else
						state = "Investigate"
						idleUntil = now + 3
						goal = nil
					end
					player:SetAttribute("SeenHiding", nil)
				end
				return
			end
			sawHide = false

			local d = (hrp.Position - root.Position).Magnitude
			if d <= M.CatchDistance and math.abs(hrp.Position.Y - root.Position.Y) < 6 then
				catch(player)
				return
			end

			if best == player then
				lastKnown = hrp.Position
				waypoints = {}
				goal = hrp.Position
				humanoid:MoveTo(hrp.Position)
			else
				if now - lastSeen > M.LoseTargetTime then
					Remotes.Notify:FireClient(player, "Ze is je kwijt... voor nu.", Color3.fromRGB(200, 200, 255))
					state = "Investigate"
					target = nil
					setGoal(lastKnown or hrp.Position)
					return
				end
				-- Ze weet ongeveer waar je bent
				if now - lastPathTime > 1 then
					setGoal(hrp.Position)
				end
				followPath()
			end
			return
		end

		shushLabel.Text = ""
		humanoid.WalkSpeed = M.WanderSpeed * room.MonsterSpeed

		if state == "Investigate" then
			if not goal then
				-- Even rondkijken na een onderzoek
				if now >= idleUntil then
					state = "Wander"
					pickWander()
				end
				return
			end
			if followPath() then
				goal = nil
				idleUntil = now + 2.5
			end
		elseif state == "Wander" then
			if not goal then
				if now >= idleUntil then
					pickWander()
				end
			elseif followPath() then
				goal = nil
				idleUntil = now + math.random(10, 30) / 10
			end
		end

		-- Vastgelopen? Kies een nieuw doel
		if now - stuckCheckTime > 2.5 then
			if goal and (root.Position - stuckCheckPos).Magnitude < 1 then
				pickWander()
			end
			stuckCheckPos = root.Position
			stuckCheckTime = now
		end
	end

	function self.Spawn()
		self.Despawn()
		buildModel(library.MonsterSpawn)
		running = true
		state = "Wander"
		target = nil
		goal = nil
		waypoints = {}
		pendingNoise = nil
		loopId += 1
		local myId = loopId
		for _, player in getPlayers() do
			Remotes.Notify:FireClient(player, M.Name .. " is wakker geworden... wees STIL.", Color3.fromRGB(255, 60, 60))
		end
		task.spawn(function()
			while running and loopId == myId do
				local ok, err = pcall(step)
				if not ok then
					warn("[Monster] " .. tostring(err))
				end
				task.wait(0.15)
			end
		end)
	end

	function self.Despawn()
		running = false
		if model then
			model:Destroy()
		end
		model, humanoid, root, head, shushLabel = nil, nil, nil, nil, nil
	end

	return self
end

return MonsterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">RoomService</string>
          <string name="Source"><![CDATA[-- Zalen: vanuit de hal kies je een deur. Elke zaal heeft zijn eigen ronde:
-- aftellen -> opruimen (met tijdslimiet en evt. monster) -> gewonnen/verloren -> terug naar de hal.
-- De status van elke zaal staat als attributen in ReplicatedStorage.RoomState.<Id>.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local BookService = require(script.Parent.BookService)
local MonsterService = require(script.Parent.MonsterService)
local DataService = require(script.Parent.DataService)
local HideService = require(script.Parent.HideService)

type Room = {
	Info: Config.RoomInfo,
	Library: any,
	Books: BookService.BookService,
	Monster: MonsterService.Monster?,
	State: Folder,
	Door: any,
	Players: { [Player]: boolean },
	Status: string, -- Idle | Starting | Playing | Won | Lost
	Finished: boolean,
	RoundRunning: boolean,
	TimeLeft: number,
}

local RoomService = {}

local rooms: { [string]: Room } = {}
local playerRoom: { [Player]: Room } = {}
local touchCooldown: { [Player]: number } = {}
local lobby

local function notify(player: Player, text: string, color: Color3?)
	Remotes.Notify:FireClient(player, text, color)
end

local function formatTime(seconds: number): string
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function roomPlayers(room: Room): { Player }
	local list = {}
	for player in room.Players do
		table.insert(list, player)
	end
	return list
end

local function isEmpty(room: Room): boolean
	return next(room.Players) == nil
end

local function updateDoor(room: Room)
	local count = #roomPlayers(room)
	local status = if room.Status == "Idle"
		then "Vrij · stap in de ring!"
		elseif room.Status == "Starting" then "Begint zo..."
		elseif room.Status == "Playing" then "Bezig · " .. formatTime(room.TimeLeft)
		else "Wordt opgeruimd..."
	room.Door.Info.Text = string.format("👥 %d   %s", count, status)
	room.State:SetAttribute("Players", count)
end

local function setState(room: Room, status: string, message: string)
	room.Status = status
	room.State:SetAttribute("RoundState", status)
	room.State:SetAttribute("Message", message)
	updateDoor(room)
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function teleport(player: Player, cf: CFrame)
	local character = player.Character
	local root = getRoot(player)
	if character and root then
		root.Anchored = false
		character:PivotTo(cf + Vector3.new(math.random(-30, 30) / 10, 0, math.random(-20, 20) / 10))
	end
end

local function sendEmptyInventory(player: Player)
	Remotes.Inventory:FireClient(player, {}, player:GetAttribute("Capacity") or Config.BaseCapacity)
end

function RoomService.GetRoom(player: Player): Room?
	return playerRoom[player]
end

function RoomService.GetBooks(player: Player): BookService.BookService?
	local room = playerRoom[player]
	return if room then room.Books else nil
end

function RoomService.Leave(player: Player, toLobby: boolean)
	local room = playerRoom[player]
	if not room then
		return
	end
	HideService.Exit(player)
	room.Books:RemovePlayer(player)
	room.Players[player] = nil
	playerRoom[player] = nil
	player:SetAttribute("Room", nil)
	touchCooldown[player] = os.clock() + 3
	if toLobby then
		teleport(player, lobby.SpawnCFrame)
		sendEmptyInventory(player)
	end
	updateDoor(room)
end

local runRound

function RoomService.Join(player: Player, roomId: string)
	local room = rooms[roomId]
	if not room or playerRoom[player] or not getRoot(player) then
		return
	end
	if room.Status == "Won" or room.Status == "Lost" then
		notify(player, room.Info.Name .. " wordt net opgeruimd. Probeer het zo nog eens!", Color3.fromRGB(255, 200, 120))
		return
	end
	room.Players[player] = true
	playerRoom[player] = room
	player:SetAttribute("Room", room.Info.Id)
	DataService.SetRoundBooks(player, 0)
	room.Books:AddPlayer(player)
	teleport(player, room.Library.SpawnCFrame)
	notify(player, "Welkom in de " .. room.Info.Name .. "!", room.Info.Color)
	if not room.RoundRunning then
		task.spawn(runRound, room)
	end
	updateDoor(room)
end

local function playRound(room: Room)
	local info = room.Info
	room.Finished = false
	room.Books:Clear()

	local aborted = false
	for t = Config.StartCountdown, 1, -1 do
		if isEmpty(room) then
			aborted = true
			break
		end
		room.TimeLeft = t
		room.State:SetAttribute("TimeLeft", t)
		setState(room, "Starting", "De zaal gaat open over " .. t .. "...")
		task.wait(1)
	end

	local elapsed = 0
	if not aborted then
		room.Books:SpawnAll()
		setState(room, "Playing", "Ruim alle kasten op!")
		for _, player in roomPlayers(room) do
			notify(player, "Zet alle boeken terug in de juiste kast!", Color3.fromRGB(255, 220, 150))
		end
		local timeLeft = info.RoundTime
		local monsterSpawned = false
		while timeLeft > 0 and not room.Finished do
			if isEmpty(room) then
				aborted = true
				break
			end
			room.TimeLeft = timeLeft
			room.State:SetAttribute("TimeLeft", timeLeft)
			updateDoor(room)
			task.wait(1)
			timeLeft -= 1
			elapsed += 1
			local monster = room.Monster
			if monster then
				monster.Progress = room.Books.Placed / room.Books.Total
				if not monsterSpawned and elapsed >= Config.Monster.SpawnDelay then
					monsterSpawned = true
					monster.Spawn()
				end
			end
		end
		room.TimeLeft = math.max(timeLeft, 0)
		room.State:SetAttribute("TimeLeft", room.TimeLeft)
	end

	room.Books.Active = false
	if room.Monster then
		room.Monster.Despawn()
	end
	if aborted then
		return
	end

	if room.Finished then
		setState(room, "Won", "DE ZAAL IS SCHOON! Tijd: " .. formatTime(elapsed))
		local reward = math.floor(Config.CoinsForWin * info.CoinMultiplier)
		for _, player in roomPlayers(room) do
			DataService.AddCoins(player, reward)
			notify(player, "+" .. reward .. " munten!", Color3.fromRGB(255, 215, 0))
			local profile = DataService.Get(player)
			if profile then
				profile.Wins += 1
				if not profile.BestTime or elapsed < profile.BestTime then
					profile.BestTime = elapsed
				end
			end
		end
	else
		setState(room, "Lost", "De tijd is op... " .. room.Books.Placed .. "/" .. room.Books.Total .. " boeken")
	end
	task.wait(Config.EndScreenTime)
	for _, player in roomPlayers(room) do
		RoomService.Leave(player, true)
	end
end

function runRound(room: Room)
	room.RoundRunning = true
	local ok, err = pcall(playRound, room)
	if not ok then
		warn("[Room " .. room.Info.Id .. "] " .. tostring(err))
	end
	room.Books.Active = false
	if room.Monster then
		room.Monster.Despawn()
	end
	room.Books:Clear()
	room.RoundRunning = false
	setState(room, "Idle", "")
	-- Kwam er iemand binnen terwijl we aan het opruimen waren? Dan meteen opnieuw.
	if not isEmpty(room) then
		task.spawn(runRound, room)
	end
end

local function createRoom(info: Config.RoomInfo, library, door, stateFolder: Folder): Room
	local state = Instance.new("Folder")
	state.Name = info.Id
	state:SetAttribute("Name", info.Name)
	state:SetAttribute("Dark", info.Dark)
	state:SetAttribute("Total", Config.RoomTotalBooks(info))
	state.Parent = stateFolder

	local room: Room = {
		Info = info,
		Library = library,
		Books = BookService.new(info, library, state),
		Monster = nil,
		State = state,
		Door = door,
		Players = {},
		Status = "Idle",
		Finished = false,
		RoundRunning = false,
		TimeLeft = 0,
	}

	room.Books.OnAllPlaced = function()
		room.Finished = true
	end
	room.Books.OnBookPlaced = function(player, count)
		DataService.AddCoins(player, math.max(1, math.floor(count * Config.CoinsPerBook * info.CoinMultiplier + 0.5)))
		DataService.SetRoundBooks(player, DataService.GetRoundBooks(player) + count)
	end

	if info.Monster then
		local monster = MonsterService.new(info, library, function()
			return roomPlayers(room)
		end)
		monster.OnCatch = function(player)
			room.Books:Scatter(player)
		end
		monster.OnHiddenCatch = function(player)
			HideService.Exit(player)
		end
		room.Books.OnMistake = function(_player, position)
			monster.Noise(position, Config.Monster.HearMistakeRange)
		end
		room.Monster = monster
	end

	library.ExitPrompt.Triggered:Connect(function(player)
		if playerRoom[player] == room then
			RoomService.Leave(player, true)
		end
	end)

	door.Prompt.Triggered:Connect(function(player)
		RoomService.Join(player, info.Id)
	end)
	door.Zone.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if player and not playerRoom[player] and os.clock() >= (touchCooldown[player] or 0) then
			touchCooldown[player] = os.clock() + 2
			RoomService.Join(player, info.Id)
		end
	end)

	setState(room, "Idle", "")
	return room
end

function RoomService.Init(lobbyData, libraries: { [string]: any })
	lobby = lobbyData
	local stateFolder = Instance.new("Folder")
	stateFolder.Name = "RoomState"
	stateFolder.Parent = ReplicatedStorage

	for _, info in Config.Rooms do
		rooms[info.Id] = createRoom(info, libraries[info.Id], lobby.Doors[info.Id], stateFolder)
	end

	Remotes.Action.OnServerEvent:Connect(function(player, action)
		local room = playerRoom[player]
		if action == "Drop" and room then
			room.Books:Drop(player)
		elseif action == "Leave" and room then
			RoomService.Leave(player, true)
		end
	end)

	local function onPlayer(player: Player)
		player:GetAttributeChangedSignal("Capacity"):Connect(function()
			local room = playerRoom[player]
			if room then
				room.Books:Changed(player)
			else
				sendEmptyInventory(player)
			end
		end)
		player.CharacterAdded:Connect(function(character)
			local humanoid = character:WaitForChild("Humanoid") :: Humanoid
			local root = character:WaitForChild("HumanoidRootPart") :: BasePart
			humanoid.Died:Connect(function()
				local room = playerRoom[player]
				if room then
					room.Books:Scatter(player)
				end
			end)
			-- Na doodgaan kom je terug in je zaal (zolang de ronde nog loopt)
			task.defer(function()
				local room = playerRoom[player]
				if room and (room.Status == "Playing" or room.Status == "Starting") then
					task.wait(0.2)
					teleport(player, room.Library.SpawnCFrame)
					room.Books:Changed(player)
				elseif room then
					RoomService.Leave(player, false)
				end
			end)
			-- Wie ergens doorheen valt, komt terug bij het begin
			task.spawn(function()
				while character.Parent do
					if root.Position.Y < -30 then
						local room = playerRoom[player]
						teleport(player, if room then room.Library.SpawnCFrame else lobby.SpawnCFrame)
					end
					task.wait(2)
				end
			end)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		RoomService.Leave(player, false)
		touchCooldown[player] = nil
	end)
end

return RoomService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Winkel, magie en de assistent: kopen met munten en de vaardigheden uitvoeren.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local KeyService = require(script.Parent.KeyService)
local RoomService = require(script.Parent.RoomService)

local ShopService = {}

local GOOD = Color3.fromRGB(120, 255, 140)
local BAD = Color3.fromRGB(255, 110, 110)

local cooldowns: { [Player]: { [string]: number } } = {}

local function notify(player: Player, text: string, color: Color3?)
	Remotes.Notify:FireClient(player, text, color)
end

local function buy(player: Player, kind: string, id: string)
	local profile = DataService.Get(player)
	if not profile then
		return
	end

	if kind == "Shop" then
		local item = Config.FindShopItem(id)
		if not item then
			return
		end
		local level = profile.Upgrades[id] or 0
		if level >= item.MaxLevel then
			notify(player, item.Name .. " is al op het hoogste niveau.", BAD)
			return
		end
		local cost = Config.ShopCost(item, level)
		if not DataService.SpendCoins(player, cost) then
			notify(player, "Niet genoeg munten! Je hebt er " .. cost .. " nodig.", BAD)
			return
		end
		profile.Upgrades[id] = level + 1
		notify(player, string.format("%s %s gekocht! (niveau %d)", item.Icon, item.Name, level + 1), GOOD)
	elseif kind == "Magic" then
		local info = Config.FindMagic(id)
		if not info then
			return
		end
		if profile.Magic[id] then
			notify(player, "Die magie heb je al.", BAD)
			return
		end
		if not DataService.SpendCoins(player, info.Cost) then
			notify(player, "Niet genoeg munten! Je hebt er " .. info.Cost .. " nodig.", BAD)
			return
		end
		profile.Magic[id] = true
		local slot = table.find(Config.Magic, info) or 0
		notify(player, string.format("%s %s ontgrendeld! Druk op %d.", info.Icon, info.Name, slot), GOOD)
	elseif kind == "Assistant" then
		local nextLevel = profile.Assistant + 1
		local levelInfo = Config.Assistant.Levels[nextLevel]
		if not levelInfo then
			notify(player, Config.Assistant.Name .. " is al op het hoogste niveau.", BAD)
			return
		end
		if not DataService.SpendCoins(player, levelInfo.Cost) then
			notify(player, "Niet genoeg munten! Je hebt er " .. levelInfo.Cost .. " nodig.", BAD)
			return
		end
		profile.Assistant = nextLevel
		notify(player, string.format("🦉 %s helpt je nu (niveau %d)!", Config.Assistant.Name, nextLevel), GOOD)
	else
		return
	end
	KeyService.Refresh(player)
end

local function useAbility(player: Player, id: string)
	local profile = DataService.Get(player)
	local info = Config.FindMagic(id)
	if not profile or not info or not profile.Magic[id] then
		return
	end
	local mine = cooldowns[player]
	if not mine then
		mine = {}
		cooldowns[player] = mine
	end
	local now = os.clock()
	-- Een klein beetje speling, de client houdt de afkoeltijd ook bij
	if (mine[id] or 0) > now + 0.5 then
		return
	end
	if id == "Assemble" then
		mine[id] = now + info.Cooldown
		local books = RoomService.GetBooks(player)
		local got = if books then books:Assemble(player, Config.AssembleRadius) else 0
		notify(player, if got > 0 then string.format("🧲 %d boek%s verzameld!", got, if got == 1 then "" else "en") else "🧲 Geen boeken in de buurt (of je handen zijn vol).", Color3.fromRGB(150, 210, 255))
	elseif id == "AutoShelf" then
		mine[id] = now + info.Cooldown
		local books = RoomService.GetBooks(player)
		local placed = if books then books:AutoShelf(player) else 0
		notify(player, if placed > 0 then string.format("✨ %d boek%s teruggezet!", placed, if placed == 1 then "" else "en") else "✨ Je draagt geen boeken.", Color3.fromRGB(255, 230, 140))
	end
end

function ShopService.Init()
	Remotes.Action.OnServerEvent:Connect(function(player, action, a, b)
		if action == "Buy" and type(a) == "string" and type(b) == "string" then
			buy(player, a, b)
		elseif action == "Ability" and type(a) == "string" then
			useAbility(player, a)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
	end)

	-- De assistent: zet om de zoveel seconden een boek terug voor elke speler die er een heeft
	task.spawn(function()
		local timers: { [Player]: number } = {}
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local profile = DataService.Get(player)
				local level = if profile then profile.Assistant else 0
				local levelInfo = Config.Assistant.Levels[level]
				local books = RoomService.GetBooks(player)
				if levelInfo and books and books.Active then
					timers[player] = (timers[player] or 0) + 1
					if timers[player] >= levelInfo.Interval then
						timers[player] = 0
						task.spawn(books.AssistantPlace, books, player)
					end
				end
			end
			for player in timers do
				if not player.Parent then
					timers[player] = nil
				end
			end
		end
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="18">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Startpunt van de client.

local Hud = require(script.Hud)
local Controls = require(script.Controls)
local Effects = require(script.Effects)

Hud.Init()
Controls.Init(Hud)
Effects.Init(Hud)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[-- Besturing: sprinten met uithoudingsvermogen, boeken laten vallen,
-- menu-toetsen (F/C/M/Z) en de vier magie-vakjes (1-4).

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local player = Players.LocalPlayer

local Controls = {}
Controls.Inventory = {} :: { any }

local Hud
local stamina = Config.MaxStamina
local sprintHeld = false
local sprintToggled = false -- voor de knop op mobiel
local cooldownUntil: { [string]: number } = {}

local function getHumanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Het model van de zaal waar je nu bent (nil = in de hal)
local function roomModel(): Instance?
	local id = player:GetAttribute("Room")
	local rooms = Workspace:FindFirstChild("Rooms")
	if type(id) ~= "string" or not rooms then
		return nil
	end
	return rooms:FindFirstChild(id)
end

local function drop()
	if #Controls.Inventory > 0 then
		Remotes.Action:FireServer("Drop")
	end
end

-- Inzicht: laat even alle losse boeken in de buurt oplichten
local function insight(): boolean
	local root = getRoot()
	local room = roomModel()
	local books = room and room:FindFirstChild("Books")
	if not root or not books then
		Hud.Notify("Ga eerst een zaal in.", Color3.fromRGB(220, 220, 220))
		return false
	end
	local markers = {}
	local found = 0
	for _, book in books:GetChildren() do
		if book:IsA("BasePart") and (book.Position - root.Position).Magnitude <= Config.InsightRadius then
			found += 1
			local bb = Instance.new("BillboardGui")
			bb.Name = "InsightMarker"
			bb.AlwaysOnTop = true
			bb.Size = UDim2.fromOffset(46, 22)
			bb.StudsOffset = Vector3.new(0, 1, 0)
			bb.LightInfluence = 0
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundColor3 = Color3.fromRGB(255, 225, 120)
			label.BackgroundTransparency = 0.15
			label.Font = Enum.Font.GothamBlack
			label.TextSize = 13
			label.TextColor3 = Color3.new(0, 0, 0)
			label.Text = tostring(book:GetAttribute("Code"))
			label.Parent = bb
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = label
			bb.Adornee = book
			bb.Parent = player:WaitForChild("PlayerGui")
			table.insert(markers, bb)
		end
	end
	Hud.Notify(string.format("👁 Inzicht: %d boeken in de buurt", found), Color3.fromRGB(255, 225, 120))
	task.delay(Config.InsightDuration, function()
		for _, bb in markers do
			bb:Destroy()
		end
	end)
	return true
end

-- Kastgids: een lichtstraal naar de kast van het eerste boek dat je draagt
local function shelfGuide(): boolean
	local book = Controls.Inventory[1]
	if not book then
		Hud.Notify("Pak eerst een boek op.", Color3.fromRGB(220, 220, 220))
		return false
	end
	local root = getRoot()
	local room = roomModel()
	local sections = room and room:FindFirstChild("Sections")
	local sectionModel = sections and sections:FindFirstChild("Section_" .. book.Code)
	local zone = sectionModel and sectionModel:FindFirstChild("PromptZone") :: BasePart?
	if not root or not zone then
		return false
	end
	local section, index = Config.FindSection(book.Code)
	local color = if index then Config.SectionColor(index) else Color3.new(1, 1, 1)

	local a0 = Instance.new("Attachment")
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Parent = zone
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color)
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Width0 = 0.6
	beam.Width1 = 2
	beam.FaceCamera = true
	beam.Transparency = NumberSequence.new(0.2, 0.5)
	beam.Parent = zone

	local bb = Instance.new("BillboardGui")
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(220, 50)
	bb.StudsOffset = Vector3.new(0, 8, 0)
	bb.Adornee = zone
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Garamond
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = "▼ " .. book.Code .. " " .. (if section then section.Name else "")
	label.Parent = bb
	bb.Parent = player:WaitForChild("PlayerGui")

	Hud.Notify("🧭 Volg het licht naar " .. book.Code, color)
	task.delay(Config.ShelfGuideDuration, function()
		beam:Destroy()
		a0:Destroy()
		a1:Destroy()
		bb:Destroy()
	end)
	return true
end

local function useAbility(id: string)
	local info = Config.FindMagic(id)
	if not info then
		return
	end
	if not player:GetAttribute("Magic_" .. id) then
		Hud.Notify(string.format("🔒 %s is nog op slot. Koop het bij Magie (C).", info.Name), Color3.fromRGB(255, 200, 120))
		return
	end
	local now = os.clock()
	if now < (cooldownUntil[id] or 0) then
		return
	end
	local used = true
	if id == "Insight" then
		used = insight()
	elseif id == "ShelfGuide" then
		used = shelfGuide()
	else
		-- Verzamelen en Auto-plaatsen gebeuren op de server
		Remotes.Action:FireServer("Ability", id)
	end
	if used then
		cooldownUntil[id] = now + info.Cooldown
	end
end

local function bindKey(name: string, callback: () -> (), ...: Enum.KeyCode)
	ContextActionService:BindAction(name, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			callback()
		end
		return Enum.ContextActionResult.Pass
	end, false, ...)
end

function Controls.Init(hud)
	Hud = hud

	-- Geen rugzak-balk: de cijfertoetsen zijn voor magie
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)

	ContextActionService:BindAction("Sprint", function(_, inputState)
		sprintHeld = inputState == Enum.UserInputState.Begin
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL3)
	bindKey("DropBooks", drop, Enum.KeyCode.G, Enum.KeyCode.ButtonB)

	for name, key in Config.MenuKeys do
		bindKey("Menu" .. name, function()
			Hud.TogglePanel(name)
		end, key)
	end

	local gamepad = { Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonR1, Enum.KeyCode.ButtonL2, Enum.KeyCode.ButtonR2 }
	for i, info in Config.Magic do
		bindKey("Magic" .. info.Id, function()
			useAbility(info.Id)
		end, info.Key, gamepad[i])
		Hud.AbilitySlots[info.Id].Activated:Connect(function()
			useAbility(info.Id)
		end)
	end

	if Hud.Buttons.Sprint then
		Hud.Buttons.Sprint.Activated:Connect(function()
			sprintToggled = not sprintToggled
			Hud.SetActive("Sprint", sprintToggled)
		end)
	end
	if Hud.Buttons.Drop then
		Hud.Buttons.Drop.Activated:Connect(drop)
	end

	Remotes.Inventory.OnClientEvent:Connect(function(list, capacity)
		Controls.Inventory = list
		Hud.SetInventory(list, capacity)
	end)

	player.CharacterAdded:Connect(function()
		stamina = Config.MaxStamina
	end)

	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for _, info in Config.Magic do
			Hud.SetCooldown(info.Id, ((cooldownUntil[info.Id] or 0) - now) / info.Cooldown)
		end
		local humanoid = getHumanoid()
		if not humanoid then
			return
		end
		local wantsSprint = (sprintHeld or sprintToggled) and not player:GetAttribute("Hidden")
		local moving = humanoid.MoveDirection.Magnitude > 0.1
		local sprinting = wantsSprint and moving and stamina > 0
		if sprinting then
			stamina = math.max(0, stamina - Config.StaminaDrain * dt)
		else
			stamina = math.min(Config.MaxStamina, stamina + Config.StaminaRegen * dt)
		end
		local walkSpeed = player:GetAttribute("WalkSpeed") or Config.WalkSpeed
		local sprintSpeed = player:GetAttribute("SprintSpeed") or Config.SprintSpeed
		humanoid.WalkSpeed = if sprinting then sprintSpeed else walkSpeed
		Hud.SetStamina(stamina / Config.MaxStamina)
	end)
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Effecten: donkere sfeer + zaklamp in de Nachtmerriezaal, flikkerende lampjes,
-- rode rand en hartslag-schudden als het monster dichtbij is, de jumpscare,
-- gevonden sleutels verbergen en de kramen in de hal.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local Effects = {}

local Hud
local flickerLights: { { part: BasePart, light: Light } } = {}
local savedLighting: { [string]: any }? = nil

local DARK_LIGHTING = {
	ClockTime = 0,
	Brightness = 0,
	Ambient = Color3.fromRGB(30, 26, 40),
	OutdoorAmbient = Color3.fromRGB(10, 10, 16),
	EnvironmentDiffuseScale = 0,
	EnvironmentSpecularScale = 0,
	FogColor = Color3.fromRGB(6, 5, 10),
	FogStart = 10,
	FogEnd = 110,
}

local function roomModel(): Instance?
	local id = player:GetAttribute("Room")
	local rooms = Workspace:FindFirstChild("Rooms")
	if type(id) ~= "string" or not rooms then
		return nil
	end
	return rooms:FindFirstChild(id)
end

-- Nachtmerrie-sfeer aan of uit (alleen voor deze speler)
local function setDark(dark: boolean)
	if dark and not savedLighting then
		local saved = {}
		for key, value in DARK_LIGHTING do
			saved[key] = (Lighting :: any)[key]
			;(Lighting :: any)[key] = value
		end
		savedLighting = saved
	elseif not dark and savedLighting then
		for key, value in savedLighting do
			(Lighting :: any)[key] = value
		end
		savedLighting = nil
	end
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Density = if dark then 0 else 0.12
	end
end

-- Een zaklamp die alleen jij ziet, in donkere zalen
local function updateFlashlight(dark: boolean)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local light = head:FindFirstChild("LocalFlashlight")
	if dark and not light then
		local spot = Instance.new("SpotLight")
		spot.Name = "LocalFlashlight"
		spot.Range = 45
		spot.Angle = 55
		spot.Brightness = 3
		spot.Shadows = true
		spot.Color = Color3.fromRGB(255, 245, 220)
		spot.Face = Enum.NormalId.Front
		spot.Parent = head
	elseif not dark and light then
		light:Destroy()
	end
end

local function collectFlickers(room: Instance?)
	table.clear(flickerLights)
	if not room then
		return
	end
	for _, d in room:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("Flicker") then
			local light = d:FindFirstChildWhichIsA("Light")
			if light then
				table.insert(flickerLights, { part = d, light = light })
			end
		end
	end
end

local function flickerLoop()
	while true do
		task.wait(0.08)
		for _, entry in flickerLights do
			if math.random() < 0.06 then
				local on = not entry.light.Enabled
				entry.light.Enabled = on
				entry.part.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
			elseif not entry.light.Enabled and math.random() < 0.4 then
				entry.light.Enabled = true
				entry.part.Material = Enum.Material.Neon
			end
		end
	end
end

local function onRoomChanged()
	local room = roomModel()
	local dark = room ~= nil and room:GetAttribute("Dark") == true
	setDark(dark)
	updateFlashlight(dark)
	collectFlickers(if dark then room else nil)
end

-- Sleutels die je al hebt worden (alleen voor jou) onzichtbaar, in alle zalen
local function updateKeys()
	local rooms = Workspace:FindFirstChild("Rooms")
	if not rooms then
		return
	end
	for _, room in rooms:GetChildren() do
		local keys = room:FindFirstChild("Keys")
		if keys then
			for _, key in keys:GetChildren() do
				if key:IsA("BasePart") then
					local has = player:GetAttribute("Key_" .. tostring(key:GetAttribute("KeyId"))) == true
					key.LocalTransparencyModifier = if has then 1 else 0
					local prompt = key:FindFirstChildOfClass("ProximityPrompt")
					if prompt then
						prompt.Enabled = not has
					end
					local light = key:FindFirstChildWhichIsA("Light")
					if light then
						light.Enabled = not has
					end
				end
			end
		end
	end
end

local function findMonster(room: Instance?): BasePart?
	if not room then
		return nil
	end
	for _, child in room:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("IsMonster") then
			return child:FindFirstChild("HumanoidRootPart") :: BasePart?
		end
	end
	return nil
end

function Effects.Init(hud)
	Hud = hud

	Workspace:WaitForChild("Rooms")
	task.spawn(flickerLoop)
	updateKeys()
	onRoomChanged()

	player.AttributeChanged:Connect(function(name)
		if string.sub(name, 1, 4) == "Key_" then
			updateKeys()
		elseif name == "Hidden" then
			Hud.SetHidden(player:GetAttribute("Hidden") == true)
		elseif name == "Room" then
			onRoomChanged()
		end
	end)
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Head")
		onRoomChanged()
	end)
	-- De sleutels komen net na de zalen binnen
	task.delay(2, updateKeys)

	-- Kramen in de hal openen een venster
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local panel = prompt:GetAttribute("OpenPanel")
		if type(panel) == "string" then
			Hud.TogglePanel(panel)
		end
	end)

	Remotes.Notify.OnClientEvent:Connect(function(text, color)
		Hud.Notify(text, color)
	end)

	Remotes.Caught.OnClientEvent:Connect(function()
		Hud.Jumpscare()
	end)

	-- Hoe dichter het monster, hoe roder het scherm en hoe meer het beeld trilt
	RunService:BindToRenderStep("MonsterDanger", Enum.RenderPriority.Camera.Value + 1, function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local monsterRoot = findMonster(roomModel())
		if not root or not monsterRoot then
			Hud.SetDanger(0)
			return
		end
		local offset = monsterRoot.Position - root.Position
		local distance = offset.Magnitude
		local sameFloor = math.abs(offset.Y) < 14
		local danger = if sameFloor then math.clamp(1 - (distance - 8) / 45, 0, 1) else 0
		-- Hartslag
		local pulse = 0.75 + 0.25 * math.sin(os.clock() * (6 + danger * 8))
		Hud.SetDanger(danger * pulse)
		if danger > 0.55 and Hud.Settings.Shake and not player:GetAttribute("Hidden") then
			local shake = (danger - 0.55) * 0.35
			camera.CFrame *= CFrame.Angles(
				math.rad((math.random() - 0.5) * shake * 4),
				math.rad((math.random() - 0.5) * shake * 4),
				0
			)
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- Het scherm, in de stijl van het origineel:
--   links: menuknoppen (Winkel F, Magie C, Assistent M, Instellingen Z)
--   linksonder: timer en de vier magie-vakjes (1-4)
--   rechtsonder: hoeveel boeken er terug staan en hoeveel je draagt
-- Plus meldingen, vensters, gevaar-rand, kast-overlay en de jumpscare.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local player = Players.LocalPlayer

local Hud = {}
Hud.Buttons = {} :: { [string]: GuiButton }
Hud.AbilitySlots = {} :: { [string]: GuiButton }
Hud.Settings = { Shake = true, Danger = true }

local NAVY = Color3.fromRGB(24, 36, 70)
local NAVY_DARK = Color3.fromRGB(16, 24, 50)
local NAVY_EDGE = Color3.fromRGB(90, 110, 160)
local CRIMSON = Color3.fromRGB(128, 18, 52)
local CRIMSON_DARK = Color3.fromRGB(96, 10, 38)
local CRIMSON_EDGE = Color3.fromRGB(220, 90, 120)
local WHITE = Color3.fromRGB(255, 252, 245)
local GOLD = Color3.fromRGB(240, 200, 110)
local SERIF = Enum.Font.Garamond
local ROUND = Enum.Font.FredokaOne

local gui: ScreenGui
local timerLabel: TextLabel
local countersHolder: Frame
local leaveButton: TextButton
local placedLabel: TextLabel
local carriedLabel: TextLabel
local sectionsLeftLabel: TextLabel
local objectiveLabel: TextLabel
local coinsLabel: TextLabel
local inventoryList: Frame
local staminaFill: Frame
local notifyHolder: Frame
local dangerFrames: { Frame } = {}
local hiddenOverlay: Frame
local bigBanner: TextLabel
local keyIcons: { [string]: Frame } = {}
local cooldownOverlays: { [string]: Frame } = {}
local lockIcons: { [string]: TextLabel } = {}
local panels: { [string]: Frame } = {}
local panelRefresh: { [string]: () -> () } = {}
local openPanel: string? = nil

local function make(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function corner(parent: Instance, radius: number?)
	make("UICorner", { CornerRadius = UDim.new(0, radius or 8), Parent = parent })
end

local function stroke(parent: Instance, color: Color3, thickness: number?, mode: Enum.ApplyStrokeMode?)
	return make("UIStroke", {
		Color = color,
		Thickness = thickness or 2,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

-- Witte tekst met een donkere rand, zoals de timer in het origineel
local function outlined(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = 1
	props.TextColor3 = props.TextColor3 or WHITE
	local label = make("TextLabel", props)
	local thick = if props.TextSize and props.TextSize > 30 then 3 else 2
	stroke(label, Color3.fromRGB(20, 14, 20), thick, Enum.ApplyStrokeMode.Contextual)
	return label
end

local function formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function coins(): number
	return player:GetAttribute("Coins") or 0
end

----------------------------------------------------------------------------
-- Vensters (winkel, magie, assistent, instellingen)
----------------------------------------------------------------------------

local function closePanels()
	for _, panel in panels do
		panel.Visible = false
	end
	openPanel = nil
end

function Hud.TogglePanel(name: string)
	local panel = panels[name]
	if not panel then
		return
	end
	local wasOpen = openPanel == name
	closePanels()
	if not wasOpen then
		panel.Visible = true
		openPanel = name
		local refresh = panelRefresh[name]
		if refresh then
			refresh()
		end
	end
end

local function refreshOpenPanel()
	if openPanel and panelRefresh[openPanel] then
		panelRefresh[openPanel]()
	end
end

local function buildPanel(name: string, title: string, accent: Color3): ScrollingFrame
	local panel = make("Frame", {
		Name = name .. "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, 440),
		BackgroundColor3 = NAVY,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	local uiScale = make("UIScale", { Parent = panel })
	corner(panel, 14)
	stroke(panel, accent, 4)
	-- Op kleine schermen (telefoon) het venster kleiner maken
	local function fit()
		local view = Workspace.CurrentCamera.ViewportSize
		uiScale.Scale = math.clamp(math.min((view.X - 20) / 560, (view.Y - 20) / 440), 0.5, 1)
	end
	fit()
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	outlined({
		Position = UDim2.fromOffset(20, 8),
		Size = UDim2.new(1, -200, 0, 50),
		Font = SERIF,
		TextSize = 42,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = title,
		ZIndex = 31,
		Parent = panel,
	})
	local coinLabel = outlined({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -64, 0, 16),
		Size = UDim2.fromOffset(130, 34),
		Font = ROUND,
		TextSize = 26,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "🪙 0",
		ZIndex = 31,
		Parent = panel,
	})
	local close = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(42, 42),
		BackgroundColor3 = CRIMSON,
		Font = ROUND,
		TextSize = 24,
		TextColor3 = WHITE,
		Text = "✕",
		ZIndex = 31,
		Parent = panel,
	})
	corner(close, 21)
	close.Activated:Connect(closePanels)

	local list = make("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 66),
		Size = UDim2.new(1, -32, 1, -82),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 31,
		Parent = panel,
	})
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	panels[name] = panel
	panelRefresh[name] = function()
		coinLabel.Text = "🪙 " .. coins()
	end
	return list
end

type RowParts = { Frame: Frame, Button: TextButton, Info: TextLabel }

local function buildRow(parent: Instance, order: number, icon: string, name: string, description: string): RowParts
	local row = make("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, -8, 0, 76),
		BackgroundColor3 = NAVY_DARK,
		ZIndex = 32,
		Parent = parent,
	})
	corner(row, 10)
	stroke(row, NAVY_EDGE, 1.5)
	make("TextLabel", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(60, 60),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 40,
		Text = icon,
		ZIndex = 33,
		Parent = row,
	})
	outlined({
		Position = UDim2.fromOffset(76, 6),
		Size = UDim2.new(1, -240, 0, 32),
		Font = SERIF,
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = name,
		ZIndex = 33,
		Parent = row,
	})
	local info = make("TextLabel", {
		Position = UDim2.fromOffset(76, 38),
		Size = UDim2.new(1, -240, 0, 32),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Color3.fromRGB(200, 205, 225),
		Text = description,
		ZIndex = 33,
		Parent = row,
	})
	local button = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(140, 48),
		BackgroundColor3 = Color3.fromRGB(46, 150, 80),
		Font = ROUND,
		TextSize = 20,
		TextColor3 = WHITE,
		Text = "",
		ZIndex = 33,
		Parent = row,
	})
	corner(button, 10)
	stroke(button, Color3.fromRGB(255, 255, 255), 1.5).Transparency = 0.6
	return { Frame = row, Button = button, Info = info }
end

local function setBuyButton(button: TextButton, text: string, enabled: boolean, affordable: boolean)
	button.Text = text
	button.AutoButtonColor = enabled
	button.Active = enabled
	button.BackgroundColor3 = if not enabled
		then Color3.fromRGB(70, 76, 96)
		elseif affordable then Color3.fromRGB(46, 150, 80)
		else Color3.fromRGB(150, 60, 60)
end

-- Voegt extra werk toe aan het verversen van een venster
local function onRefresh(name: string, fn: () -> ())
	local previous = panelRefresh[name]
	panelRefresh[name] = function()
		if previous then
			previous()
		end
		fn()
	end
end

local function buildShopPanel()
	local list = buildPanel("Shop", "Winkel", CRIMSON_EDGE)
	local rows = {}
	for i, item in Config.Shop do
		local row = buildRow(list, i, item.Icon, item.Name, item.Description)
		row.Button.Activated:Connect(function()
			Remotes.Action:FireServer("Buy", "Shop", item.Id)
		end)
		rows[item.Id] = row
	end
	onRefresh("Shop", function()
		for _, item in Config.Shop do
			local row = rows[item.Id]
			local level = player:GetAttribute("Up_" .. item.Id) or 0
			row.Info.Text = string.format("%s  •  niveau %d/%d", item.Description, level, item.MaxLevel)
			if level >= item.MaxLevel then
				setBuyButton(row.Button, "MAX", false, false)
			else
				local cost = Config.ShopCost(item, level)
				setBuyButton(row.Button, "🪙 " .. cost, true, coins() >= cost)
			end
		end
	end)
end

local function buildMagicPanel()
	local list = buildPanel("Magic", "Magie", NAVY_EDGE)
	local rows = {}
	for i, info in Config.Magic do
		local row = buildRow(list, i, info.Icon, string.format("%d · %s", i, info.Name), info.Description)
		row.Button.Activated:Connect(function()
			Remotes.Action:FireServer("Buy", "Magic", info.Id)
		end)
		rows[info.Id] = row
	end
	-- De vier verborgen sleutels
	make("TextLabel", {
		LayoutOrder = 50,
		Size = UDim2.new(1, -8, 0, 30),
		BackgroundTransparency = 1,
		Font = SERIF,
		TextSize = 26,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "🔑 Verborgen sleutels",
		ZIndex = 32,
		Parent = list,
	})
	local keyRows = {}
	for i, info in Config.Keys do
		local row = buildRow(list, 50 + i, "🔑", info.Name, info.Description)
		row.Button.Active = false
		row.Button.AutoButtonColor = false
		keyRows[info.Id] = row
	end
	onRefresh("Magic", function()
		for _, info in Config.Magic do
			local row = rows[info.Id]
			if player:GetAttribute("Magic_" .. info.Id) then
				setBuyButton(row.Button, "✔ Ontgrendeld", false, true)
				row.Info.Text = string.format("%s  •  afkoeltijd %ds", info.Description, info.Cooldown)
			else
				setBuyButton(row.Button, "🪙 " .. info.Cost, true, coins() >= info.Cost)
			end
		end
		for _, info in Config.Keys do
			local row = keyRows[info.Id]
			local has = player:GetAttribute("Key_" .. info.Id) == true
			row.Button.Text = if has then "✔ Gevonden" else "❓ Zoek!"
			row.Button.BackgroundColor3 = if has then info.Color else Color3.fromRGB(70, 76, 96)
		end
	end)
end

local function buildAssistantPanel()
	local list = buildPanel("Assistant", "Assistent", NAVY_EDGE)
	local row = buildRow(list, 1, "🦉", Config.Assistant.Name, "")
	row.Button.Activated:Connect(function()
		Remotes.Action:FireServer("Buy", "Assistant", "Owl")
	end)
	make("TextLabel", {
		LayoutOrder = 2,
		Size = UDim2.new(1, -8, 0, 120),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Color3.fromRGB(210, 215, 235),
		Text = "Je magische uil laat af en toe een boek naar de goede kast zweven. "
			.. "Hoe hoger het niveau, hoe vaker hij helpt. De boeken die hij terugzet tellen voor jou en leveren munten op.",
		ZIndex = 32,
		Parent = list,
	})
	onRefresh("Assistant", function()
		local level = player:GetAttribute("Assistant") or 0
		local current = Config.Assistant.Levels[level]
		local nextInfo = Config.Assistant.Levels[level + 1]
		row.Info.Text = if current
			then string.format("Niveau %d: zet elke %d seconden een boek terug", level, current.Interval)
			else "Nog geen assistent"
		if nextInfo then
			local label = if level == 0 then "Koop" else "Niv. " .. (level + 1)
			setBuyButton(row.Button, label .. " 🪙" .. nextInfo.Cost, true, coins() >= nextInfo.Cost)
		else
			setBuyButton(row.Button, "MAX", false, false)
		end
	end)
end

local function buildSettingsPanel()
	local list = buildPanel("Settings", "Instellingen", NAVY_EDGE)
	local options = {
		{ "Shake", "📳", "Schermschudden", "Het beeld trilt als het monster dichtbij is" },
		{ "Danger", "🟥", "Gevarenrand", "Rode rand als het monster dichtbij is" },
	}
	local rows = {}
	for i, option in options do
		local key = option[1]
		local row = buildRow(list, i, option[2], option[3], option[4])
		row.Button.Activated:Connect(function()
			local settings = Hud.Settings :: any
			settings[key] = not settings[key]
			refreshOpenPanel()
		end)
		rows[key] = row
	end
	make("TextLabel", {
		LayoutOrder = 10,
		Size = UDim2.new(1, -8, 0, 210),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Color3.fromRGB(210, 215, 235),
		Text = "Besturing\n"
			.. "E  boek oppakken / terugzetten / verstoppen\n"
			.. "1-4  magie gebruiken (eerst kopen bij Magie)\n"
			.. "Shift  sprinten (maakt lawaai!)\n"
			.. "G  boeken laten vallen\n"
			.. "F Winkel  •  C Magie  •  M Assistent  •  Z Instellingen\n\n"
			.. "Lees de code op elk boek (bijv. 1H) en breng het naar de kast met hetzelfde groene bordje.",
		ZIndex = 32,
		Parent = list,
	})
	onRefresh("Settings", function()
		for key, row in rows do
			local on = (Hud.Settings :: any)[key] == true
			setBuyButton(row.Button, if on then "AAN" else "UIT", true, on)
		end
	end)
end

